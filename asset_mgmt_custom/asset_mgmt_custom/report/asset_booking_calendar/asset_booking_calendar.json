{
  "doctype": "Report",
  "name": "Asset Booking Calendar",
  "report_name": "Asset Booking Calendar",
  "ref_doctype": "Asset Booking",
  "report_type": "Script Report",
  "is_standard": "Yes",
  "module": "Asset Mgmt Custom",
  "disabled": 0,
  "filters": [
    {
      "fieldname": "asset",
      "label": "Asset",
      "fieldtype": "Link",
      "options": "Asset"
    },
    {
      "fieldname": "asset_category",
      "label": "Asset Category",
      "fieldtype": "Link",
      "options": "Asset Category"
    },
    {
      "fieldname": "from_date",
      "label": "From Date",
      "fieldtype": "Date",
      "reqd": 1,
      "default": "eval:frappe.datetime.month_start()"
    },
    {
      "fieldname": "to_date",
      "label": "To Date",
      "fieldtype": "Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "\nPending\nApproved\nCompleted\nCancelled"
    }
  ]
}
