{
  "doctype": "Print Format",
  "name": "Asset Delivery Certificate",
  "doc_type": "Asset Movement",
  "module": "Asset Mgmt Custom",
  "print_format_type": "Jinja",
  "standard": "No",
  "disabled": 0,
  "html": "{%- set company_name = doc.company -%}\n<div style=\"font-family: 'Arial', sans-serif; direction: rtl; padding: 20px;\">\n  <div style=\"text-align: center; border-bottom: 2px solid #0E5C78; padding-bottom: 16px; margin-bottom: 20px;\">\n    <h2 style=\"color: #0E5C78; margin: 0;\">{{ company_name }}</h2>\n    <h3 style=\"margin: 8px 0 0 0;\">شهادة تسليم واستلام أصل ثابت</h3>\n    <h4 style=\"font-weight: normal; margin: 4px 0 0 0;\">Asset Delivery Certificate</h4>\n  </div>\n\n  <table style=\"width:100%; margin-bottom: 16px; border-collapse: collapse;\">\n    <tr>\n      <td style=\"width:50%; padding:4px 8px;\"><b>رقم المستند / Doc No:</b> {{ doc.name }}</td>\n      <td style=\"width:50%; padding:4px 8px;\"><b>التاريخ / Date:</b> {{ frappe.format(doc.transaction_date, 'Datetime') }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:4px 8px;\"><b>الغرض / Purpose:</b> {{ doc.purpose }}</td>\n      <td style=\"padding:4px 8px;\"><b>الشركة / Company:</b> {{ doc.company }}</td>\n    </tr>\n    {%- if doc.custom_driver_name %}\n    <tr>\n      <td style=\"padding:4px 8px;\"><b>السائق / Driver:</b> {{ doc.custom_driver_name }}</td>\n      <td style=\"padding:4px 8px;\"><b>رقم السيارة / Vehicle:</b> {{ doc.custom_vehicle_number or '—' }}</td>\n    </tr>\n    {%- endif %}\n    {%- if doc.custom_expected_arrival %}\n    <tr>\n      <td colspan=\"2\" style=\"padding:4px 8px;\"><b>التوقيت المتوقع للوصول / Expected Arrival:</b> {{ frappe.format(doc.custom_expected_arrival, 'Datetime') }}</td>\n    </tr>\n    {%- endif %}\n  </table>\n\n  <table style=\"width:100%; border-collapse: collapse; margin-bottom: 20px; font-size: 13px;\">\n    <thead>\n      <tr style=\"background:#0E5C78; color:#fff;\">\n        <th style=\"padding:8px; border:1px solid #ccc;\">#</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">كود الأصل</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">اسم الأصل</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">من الموقع</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">إلى الموقع</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">كود الترميز</th>\n      </tr>\n    </thead>\n    <tbody>\n      {%- for item in doc.assets %}\n      {%- set asset_doc = frappe.get_doc(\"Asset\", item.asset) %}\n      <tr style=\"background: {{ loop.index % 2 == 0 and '#f9f9f9' or '#fff' }}\">\n        <td style=\"padding:6px 8px; border:1px solid #ddd; text-align:center;\">{{ loop.index }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ item.asset }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ item.asset_name or '' }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ item.source_location or '—' }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ item.target_location or item.to_employee or '—' }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ asset_doc.custom_iron_code or asset_doc.custom_sticker_code or '—' }}</td>\n      </tr>\n      {%- endfor %}\n    </tbody>\n  </table>\n\n  <div style=\"display: flex; gap: 40px; margin-top: 40px;\">\n    <div style=\"flex:1; border-top: 1px solid #333; padding-top: 8px; text-align: center;\">\n      <div>المسلِّم / Delivered By</div>\n      <div style=\"margin-top: 40px; font-size:12px; color:#666;\">التوقيع / Signature</div>\n    </div>\n    <div style=\"flex:1; border-top: 1px solid #333; padding-top: 8px; text-align: center;\">\n      <div>السائق / Driver</div>\n      <div style=\"margin-top: 40px; font-size:12px; color:#666;\">التوقيع / Signature</div>\n    </div>\n    <div style=\"flex:1; border-top: 1px solid #333; padding-top: 8px; text-align: center;\">\n      <div>المستلِم / Received By</div>\n      <div style=\"margin-top: 40px; font-size:12px; color:#666;\">التوقيع / Signature</div>\n    </div>\n  </div>\n\n  <div style=\"text-align:center; margin-top:30px; font-size:11px; color:#999; border-top:1px solid #eee; padding-top:8px;\">\n    تم إنشاء هذه الوثيقة آلياً من نظام ERP — {{ frappe.utils.now() }}\n  </div>\n</div>"
}
