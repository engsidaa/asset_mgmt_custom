{
  "doctype": "Print Format",
  "name": "Asset Count Sheet",
  "doc_type": "Asset",
  "module": "Asset Mgmt Custom",
  "print_format_type": "Jinja",
  "standard": "No",
  "disabled": 0,
  "html": "{% set assets = frappe.db.sql(\"\"\"\n    SELECT name, asset_name, asset_category, location, custodian,\n           custom_sticker_code, custom_iron_code, status\n    FROM `tabAsset`\n    WHERE docstatus < 2\n    {% if doc.location %}AND location = '{{ doc.location }}'{% endif %}\n    ORDER BY location, asset_category, asset_name\n\"\"\", as_dict=True) %}\n<div style=\"font-family: Arial, sans-serif; font-size: 11px; padding: 20px;\">\n  <div style=\"text-align:center; margin-bottom:16px;\">\n    <div style=\"font-size:16px; font-weight:bold;\">{{ doc.company }} — Asset Count Sheet</div>\n    <div style=\"font-size:12px; color:#555;\">كشف جرد الأصول</div>\n    <div style=\"font-size:10px; color:#888; margin-top:4px;\">Date: {{ frappe.utils.today() }}</div>\n  </div>\n  <table style=\"width:100%; border-collapse:collapse;\">\n    <thead>\n      <tr style=\"background:#1e3a5f; color:#fff;\">\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:left;\">#</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:left;\">Asset ID</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:left;\">Asset Name / اسم الأصل</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:left;\">Category</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:left;\">Location</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:left;\">Sticker</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:center; width:70px;\">Found ✓</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:left; width:150px;\">Notes / ملاحظات</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for a in assets %}\n      <tr style=\"background: {{ 'white' if loop.index % 2 == 1 else '#f8fafc' }};\">\n        <td style=\"border:1px solid #ddd; padding:5px;\">{{ loop.index }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px; font-weight:bold;\">{{ a.name }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px;\">{{ a.asset_name }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px;\">{{ a.asset_category }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px;\">{{ a.location or '' }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px;\">{{ a.custom_sticker_code or '' }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px; text-align:center;\">□</td>\n        <td style=\"border:1px solid #ddd; padding:5px;\">&nbsp;</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  <div style=\"margin-top:30px; display:flex; gap:80px;\">\n    <div><div style=\"border-top:1px solid #333; width:180px; padding-top:4px;\">Auditor Signature / توقيع المراجع</div></div>\n    <div><div style=\"border-top:1px solid #333; width:180px; padding-top:4px;\">Date / التاريخ</div></div>\n    <div><div style=\"border-top:1px solid #333; width:180px; padding-top:4px;\">Manager Approval / اعتماد المدير</div></div>\n  </div>\n</div>"
}
