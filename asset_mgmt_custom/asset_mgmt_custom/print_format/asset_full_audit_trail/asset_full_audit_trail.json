{
  "doctype": "Print Format",
  "name": "Asset Full Audit Trail",
  "doc_type": "Asset",
  "module": "Asset Mgmt Custom",
  "print_format_type": "Jinja",
  "standard": "No",
  "disabled": 0,
  "html": "<div dir=\"rtl\" style=\"font-family: Arial, sans-serif; font-size: 12px; padding: 20px;\">\n  <div style=\"text-align:center; margin-bottom:16px; border-bottom:2px solid #1e3a5f; padding-bottom:10px;\">\n    <div style=\"font-size:18px; font-weight:bold; color:#1e3a5f;\">سجل التدقيق الكامل للأصل</div>\n    <div style=\"font-size:13px; color:#555; margin-top:4px;\">{{ doc.name }} — {{ doc.asset_name }}</div>\n    <div style=\"font-size:10px; color:#888; margin-top:4px;\">تاريخ الإصدار: {{ frappe.utils.today() }}</div>\n  </div>\n\n  <table style=\"width:100%; border-collapse:collapse; margin-bottom:20px;\">\n    <tr>\n      <td style=\"padding:4px; font-weight:bold; width:110px;\">الفئة</td><td style=\"padding:4px;\">{{ doc.asset_category }}</td>\n      <td style=\"padding:4px; font-weight:bold; width:110px;\">الفرع</td><td style=\"padding:4px;\">{{ doc.custom_branch or '-' }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:4px; font-weight:bold;\">الحالة</td><td style=\"padding:4px;\">{{ doc.status }}</td>\n      <td style=\"padding:4px; font-weight:bold;\">الموقع</td><td style=\"padding:4px;\">{{ doc.location or '-' }}</td>\n    </tr>\n  </table>\n\n  {% set trail = frappe.call('asset_mgmt_custom.audit_trail.get_asset_audit_trail', asset=doc.name) %}\n  {% if trail %}\n  <table style=\"width:100%; border-collapse:collapse;\">\n    <thead>\n      <tr style=\"background:#1e3a5f; color:#fff;\">\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:right; width:100px;\">التاريخ</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:right; width:110px;\">النوع</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:right;\">التفاصيل</th>\n        <th style=\"border:1px solid #ccc; padding:6px; text-align:right; width:130px;\">المرجع</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for e in trail %}\n      <tr style=\"background: {{ 'white' if loop.index % 2 == 1 else '#f8fafc' }};\">\n        <td style=\"border:1px solid #ddd; padding:5px;\">{{ e.date }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px; font-weight:bold;\">{{ e.type_label }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px;\">{{ e.summary }}</td>\n        <td style=\"border:1px solid #ddd; padding:5px;\">{{ e.reference_doctype }}: {{ e.reference_name }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  {% else %}\n  <div style=\"text-align:center; color:#888; padding:30px;\">لا توجد أي سجلات مرتبطة بهذا الأصل بعد.</div>\n  {% endif %}\n</div>"
}
