{
  "doctype": "DocType",
  "name": "Asset Compliance Certificate",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "field:certificate_number",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "certificate_number",
      "fieldtype": "Data",
      "label": "Certificate Number",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1,
      "unique": 1
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Asset",
      "options": "Asset",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1
    },
    {
      "fieldname": "col1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "certificate_type",
      "fieldtype": "Select",
      "label": "Certificate Type",
      "options": "\nFire Safety\nElectrical Safety\nPressure Vessel\nLift/Elevator\nFood Safety\nHealth & Safety\nEnvironmental\nOther",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Active\nExpired\nPending Renewal\nCancelled",
      "default": "Active",
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "section_dates",
      "fieldtype": "Section Break",
      "label": "Certificate Details"
    },
    {
      "fieldname": "issuing_authority",
      "fieldtype": "Data",
      "label": "Issuing Authority",
      "reqd": 1
    },
    {
      "fieldname": "issue_date",
      "fieldtype": "Date",
      "label": "Issue Date",
      "reqd": 1
    },
    {
      "fieldname": "col2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "expiry_date",
      "fieldtype": "Date",
      "label": "Expiry Date",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "renewal_reminder_days",
      "fieldtype": "Int",
      "label": "Remind Before Expiry (Days)",
      "default": "30",
      "description": "Send alert this many days before expiry date"
    },
    {
      "fieldname": "section_branch",
      "fieldtype": "Section Break",
      "label": "Branch & Company"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Branch",
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "section_docs",
      "fieldtype": "Section Break",
      "label": "Documentation",
      "collapsible": 1
    },
    {
      "fieldname": "certificate_document",
      "fieldtype": "Attach",
      "label": "Certificate Document (PDF)"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "Assets Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "search_fields": "asset, certificate_type, status",
  "title_field": "certificate_number",
  "sort_field": "expiry_date",
  "sort_order": "ASC"
}
