{
  "doctype": "DocType",
  "name": "Asset Preventive Maintenance Schedule",
  "module": "Asset Mgmt Custom",
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "naming_series:",
  "naming_series": "PMS-.YYYY.-",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "PMS-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "الأصل",
      "options": "Asset",
      "reqd": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "اسم الأصل",
      "fetch_from": "asset.asset_name",
      "read_only": 1
    },
    {
      "fieldname": "asset_category",
      "fieldtype": "Link",
      "label": "فئة الأصل",
      "options": "Asset Category",
      "fetch_from": "asset.asset_category",
      "read_only": 1
    },
    {
      "fieldname": "maintenance_type",
      "fieldtype": "Select",
      "label": "نوع الصيانة",
      "description": "تكرار الصيانة: يومي أو أسبوعي أو شهري...",
      "options": "Daily\nWeekly\nMonthly\nQuarterly\nSemi-Annual\nAnnual\nUsage-Based",
      "reqd": 1
    },
    {
      "fieldname": "maintenance_task",
      "fieldtype": "Data",
      "label": "مهمة الصيانة",
      "description": "وصف المهمة أو الإجراء المطلوب تنفيذه",
      "reqd": 1
    },
    {
      "fieldname": "assigned_to",
      "fieldtype": "Link",
      "label": "مسؤول الصيانة",
      "description": "الموظف المكلف بتنفيذ هذه الصيانة",
      "options": "Employee"
    },
    {
      "fieldname": "last_done_date",
      "fieldtype": "Date",
      "label": "تاريخ آخر تنفيذ"
    },
    {
      "fieldname": "next_due_date",
      "fieldtype": "Date",
      "label": "تاريخ الاستحقاق القادم",
      "description": "التاريخ المحدد للصيانة القادمة",
      "reqd": 1
    },
    {
      "fieldname": "frequency_days",
      "fieldtype": "Int",
      "label": "التكرار (بالأيام)",
      "description": "عدد الأيام بين كل دورة صيانة"
    },
    {
      "fieldname": "estimated_duration_hours",
      "fieldtype": "Float",
      "label": "المدة التقديرية (ساعات)",
      "description": "الوقت المتوقع لتنفيذ مهمة الصيانة"
    },
    {
      "fieldname": "checklist",
      "fieldtype": "Text",
      "label": "قائمة المراجعة",
      "description": "خطوات الصيانة التفصيلية يُدرَج كل بند في سطر"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "الحالة",
      "options": "Active\nOverdue\nCompleted\nSuspended",
      "default": "Active"
    },
    {
      "fieldname": "auto_create_repair",
      "fieldtype": "Check",
      "label": "إنشاء أمر إصلاح تلقائياً عند الاستحقاق"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 0,
      "cancel": 0,
      "delete": 1
    }
  ]
}
