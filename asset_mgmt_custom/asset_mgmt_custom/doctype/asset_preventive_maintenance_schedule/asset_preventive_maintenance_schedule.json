{
  "doctype": "DocType",
  "name": "Asset Preventive Maintenance Schedule",
  "module": "Asset Mgmt Custom",
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "naming_series:",
  "naming_series": "PMS-.YYYY.-",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "PMS-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Asset",
      "options": "Asset",
      "reqd": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1
    },
    {
      "fieldname": "asset_category",
      "fieldtype": "Link",
      "label": "Asset Category",
      "options": "Asset Category",
      "fetch_from": "asset.asset_category",
      "read_only": 1
    },
    {
      "fieldname": "maintenance_type",
      "fieldtype": "Select",
      "label": "Maintenance Type",
      "options": "Daily\nWeekly\nMonthly\nQuarterly\nSemi-Annual\nAnnual\nUsage-Based",
      "reqd": 1
    },
    {
      "fieldname": "maintenance_task",
      "fieldtype": "Data",
      "label": "Maintenance Task Description",
      "reqd": 1
    },
    {
      "fieldname": "assigned_to",
      "fieldtype": "Link",
      "label": "Assigned To",
      "options": "Employee"
    },
    {
      "fieldname": "last_done_date",
      "fieldtype": "Date",
      "label": "Last Done Date"
    },
    {
      "fieldname": "next_due_date",
      "fieldtype": "Date",
      "label": "Next Due Date",
      "reqd": 1
    },
    {
      "fieldname": "frequency_days",
      "fieldtype": "Int",
      "label": "Frequency (Days)"
    },
    {
      "fieldname": "estimated_duration_hours",
      "fieldtype": "Float",
      "label": "Estimated Duration (Hours)"
    },
    {
      "fieldname": "checklist",
      "fieldtype": "Text",
      "label": "Maintenance Checklist"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Active\nOverdue\nCompleted\nSuspended",
      "default": "Active"
    },
    {
      "fieldname": "auto_create_repair",
      "fieldtype": "Check",
      "label": "Auto-create Repair Order on Due Date"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 0,
      "cancel": 0,
      "delete": 1
    }
  ]
}
