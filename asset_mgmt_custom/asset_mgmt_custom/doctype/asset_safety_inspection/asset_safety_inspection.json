{
 "doctype": "DocType",
 "name": "Asset Safety Inspection",
 "module": "Asset Mgmt Custom",
 "naming_rule": "Expression",
 "autoname": "format:SAFE-{inspection_date}-{asset}",
 "is_submittable": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "الأصل",
   "options": "Asset",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "label": "الفرع",
   "options": "Branch",
   "fetch_from": "asset.custom_branch",
   "in_list_view": 1
  },
  {
   "fieldname": "inspection_type",
   "fieldtype": "Select",
   "label": "نوع التفتيش",
   "options": "Fire Safety\nElectrical Safety\nStructural Safety\nHygiene & Sanitation\nGeneral Safety\nOther",
   "reqd": 1,
   "in_list_view": 1,
   "description": "نوع فحص السلامة المُجرى"
  },
  {
   "fieldname": "sec_break_1",
   "fieldtype": "Section Break",
   "label": "بيانات التفتيش"
  },
  {
   "fieldname": "inspection_date",
   "fieldtype": "Date",
   "label": "تاريخ التفتيش",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "inspector",
   "fieldtype": "Data",
   "label": "المفتش",
   "reqd": 1,
   "description": "الموظف المسؤول عن إجراء فحص السلامة"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "overall_result",
   "fieldtype": "Select",
   "label": "النتيجة الإجمالية",
   "options": "\nPass\nFail\nNeeds Action",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1,
   "description": "الحكم النهائي على سلامة الأصل"
  },
  {
   "fieldname": "next_inspection_date",
   "fieldtype": "Date",
   "label": "تاريخ الفحص القادم"
  },
  {
   "fieldname": "sec_break_items",
   "fieldtype": "Section Break",
   "label": "نتيجة الفحص"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "بنود الفحص",
   "options": "Asset Safety Inspection Item",
   "description": "قائمة تفصيلية بكل بند من بنود فحص السلامة"
  },
  {
   "fieldname": "sec_break_notes",
   "fieldtype": "Section Break",
   "label": "ملاحظات"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text Editor",
   "label": "ملاحظات"
  }
 ],
