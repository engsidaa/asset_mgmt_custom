{
  "doctype": "DocType",
  "name": "Asset Safety Inspection",
  "module": "Asset Mgmt Custom",
  "naming_rule": "Expression",
  "autoname": "format:SAFE-{inspection_date}-{asset}",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Asset",
      "options": "Asset",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Branch",
      "fetch_from": "asset.custom_branch",
      "in_list_view": 1
    },
    {
      "fieldname": "inspection_type",
      "fieldtype": "Select",
      "label": "Inspection Type",
      "options": "Fire Safety\nElectrical Safety\nStructural Safety\nHygiene & Sanitation\nGeneral Safety\nOther",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sec_break_1",
      "fieldtype": "Section Break",
      "label": "Inspection Details"
    },
    {
      "fieldname": "inspection_date",
      "fieldtype": "Date",
      "label": "Inspection Date",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "inspector",
      "fieldtype": "Data",
      "label": "Inspector",
      "reqd": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "overall_result",
      "fieldtype": "Select",
      "label": "Overall Result",
      "options": "\nPass\nFail\nNeeds Action",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "next_inspection_date",
      "fieldtype": "Date",
      "label": "Next Inspection Date"
    },
    {
      "fieldname": "sec_break_items",
      "fieldtype": "Section Break",
      "label": "Checklist Items"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Checklist Items",
      "options": "Asset Safety Inspection Item"
    },
    {
      "fieldname": "sec_break_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Notes"
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset User", "read": 1, "write": 1, "create": 1}
  ]
}
