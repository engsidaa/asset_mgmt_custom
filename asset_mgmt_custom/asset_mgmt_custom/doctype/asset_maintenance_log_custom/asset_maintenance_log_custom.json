{
  "doctype": "DocType",
  "name": "Asset Maintenance Log Custom",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "السلسلة",
      "options": "MNTLOG-.YYYY.-",
      "default": "MNTLOG-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "options": "Asset",
      "label": "الأصل",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "اسم الأصل",
      "fetch_from": "asset.asset_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "options": "Branch",
      "label": "الفرع",
      "fetch_from": "asset.custom_branch",
      "in_list_view": 1
    },
    {
      "fieldname": "maintenance_date",
      "fieldtype": "Date",
      "label": "تاريخ الصيانة",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "sec_break_maint",
      "fieldtype": "Section Break",
      "label": "تفاصيل الصيانة"
    },
    {
      "fieldname": "maintenance_type",
      "fieldtype": "Select",
      "label": "نوع الصيانة",
      "description": "وقائية، تصحيحية، طارئة...",
      "options": "\nPreventive\nCorrective\nEmergency\nPredictive\nOverhaul",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "performed_by",
      "fieldtype": "Data",
      "label": "نفَّذ الصيانة",
      "description": "الفني أو الشركة التي أجرت الصيانة",
      "reqd": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "technician_name",
      "fieldtype": "Data",
      "label": "اسم الفني"
    },
    {
      "fieldname": "duration_hours",
      "fieldtype": "Float",
      "label": "المدة (ساعات)"
    },
    {
      "fieldname": "maintenance_cost",
      "fieldtype": "Currency",
      "label": "التكلفة"
    },
    {
      "fieldname": "sec_break_work",
      "fieldtype": "Section Break",
      "label": "تفاصيل العمل"
    },
    {
      "fieldname": "findings",
      "fieldtype": "Text Editor",
      "label": "النتائج / وصف المشكلة"
    },
    {
      "fieldname": "work_done",
      "fieldtype": "Text Editor",
      "label": "وصف العمل المنجز",
      "description": "تفاصيل أعمال الصيانة التي تمت"
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "spare_parts_used",
      "fieldtype": "Text",
      "label": "قطع الغيار المستخدمة"
    },
    {
      "fieldname": "next_maintenance_date",
      "fieldtype": "Date",
      "label": "تاريخ الصيانة القادمة"
    },
    {
      "fieldname": "sec_break_notes",
      "fieldtype": "Section Break",
      "label": "ملاحظات"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "ملاحظات"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Asset Manager",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Asset User",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
