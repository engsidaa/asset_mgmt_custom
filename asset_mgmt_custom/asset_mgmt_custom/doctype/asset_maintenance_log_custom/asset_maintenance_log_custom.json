{
  "doctype": "DocType",
  "name": "Asset Maintenance Log Custom",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "MNTLOG-.YYYY.-",
      "default": "MNTLOG-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "options": "Asset",
      "label": "Asset",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "options": "Branch",
      "label": "Branch",
      "fetch_from": "asset.custom_branch",
      "in_list_view": 1
    },
    {
      "fieldname": "maintenance_date",
      "fieldtype": "Date",
      "label": "Maintenance Date",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "sec_break_maint",
      "fieldtype": "Section Break",
      "label": "Maintenance Details"
    },
    {
      "fieldname": "maintenance_type",
      "fieldtype": "Select",
      "label": "Maintenance Type",
      "options": "\nPreventive\nCorrective\nEmergency\nPredictive\nOverhaul",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "performed_by",
      "fieldtype": "Data",
      "label": "Performed By (Company)",
      "reqd": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "technician_name",
      "fieldtype": "Data",
      "label": "Technician Name"
    },
    {
      "fieldname": "duration_hours",
      "fieldtype": "Float",
      "label": "Duration (Hours)"
    },
    {
      "fieldname": "maintenance_cost",
      "fieldtype": "Currency",
      "label": "Cost"
    },
    {
      "fieldname": "sec_break_work",
      "fieldtype": "Section Break",
      "label": "Work Details"
    },
    {
      "fieldname": "findings",
      "fieldtype": "Text Editor",
      "label": "Findings / Problem Description"
    },
    {
      "fieldname": "work_done",
      "fieldtype": "Text Editor",
      "label": "Work Done"
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "spare_parts_used",
      "fieldtype": "Text",
      "label": "Spare Parts Used"
    },
    {
      "fieldname": "next_maintenance_date",
      "fieldtype": "Date",
      "label": "Next Scheduled Maintenance"
    },
    {
      "fieldname": "sec_break_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Asset Manager",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Asset User",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
