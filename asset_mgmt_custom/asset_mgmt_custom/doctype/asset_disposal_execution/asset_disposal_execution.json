{
  "doctype": "DocType",
  "name": "Asset Disposal Execution",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Naming Series", "options": "DISP-.YYYY.-", "default": "DISP-.YYYY.-"},
    {"fieldname": "disposal_request", "fieldtype": "Link", "label": "Asset Disposal Request", "options": "Asset Disposal Request", "in_list_view": 1, "search_index": 1},
    {"fieldname": "asset", "fieldtype": "Link", "label": "Asset", "options": "Asset", "reqd": 1, "in_list_view": 1, "search_index": 1, "bold": 1},
    {"fieldname": "asset_name", "fieldtype": "Data", "label": "Asset Name", "fetch_from": "asset.asset_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "branch", "fieldtype": "Link", "label": "Branch", "options": "Branch", "fetch_from": "asset.custom_branch"},
    {"fieldname": "disposal_status", "fieldtype": "Select", "label": "Disposal Status", "options": "Pending\nExecuted\nCancelled", "default": "Pending", "read_only": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "sec_break_disposal", "fieldtype": "Section Break", "label": "Disposal Details"},
    {"fieldname": "disposal_method", "fieldtype": "Select", "label": "Disposal Method", "options": "\nSold\nScrapped\nDonated\nDestroyed\nAuctioned", "reqd": 1, "in_list_view": 1},
    {"fieldname": "execution_date", "fieldtype": "Date", "label": "Execution Date", "reqd": 1},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "actual_sale_value", "fieldtype": "Currency", "label": "Actual Sale / Scrap Value"},
    {"fieldname": "buyer_name", "fieldtype": "Data", "label": "Buyer / Recipient Name"},
    {"fieldname": "sec_break_docs", "fieldtype": "Section Break", "label": "Documents"},
    {"fieldname": "buyer_contact", "fieldtype": "Data", "label": "Buyer Contact"},
    {"fieldname": "col_break_3", "fieldtype": "Column Break"},
    {"fieldname": "disposal_document", "fieldtype": "Attach", "label": "Disposal Document"},
    {"fieldname": "notes", "fieldtype": "Text Editor", "label": "Notes"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset User", "read": 1, "write": 1, "create": 1}
  ]
}
