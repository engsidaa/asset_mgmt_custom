{
  "doctype": "DocType",
  "name": "Asset Incident Report",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "سلسلة الترقيم",
      "options": "INCIDENT-.YYYY.-",
      "default": "INCIDENT-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "الأصل",
      "options": "Asset",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "الفرع",
      "options": "Branch",
      "fetch_from": "asset.custom_branch",
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "الحالة",
      "options": "Open\nUnder Investigation\nResolved\nClosed",
      "default": "Open",
      "read_only": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "severity",
      "fieldtype": "Select",
      "label": "درجة الخطورة",
      "options": "\nLow\nMedium\nHigh\nCritical",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1,
      "description": "مستوى خطورة الحادث: منخفض، متوسط، عالٍ، حرج"
    },
    {
      "fieldname": "sec_break_incident",
      "fieldtype": "Section Break",
      "label": "تفاصيل الحادث"
    },
    {
      "fieldname": "incident_date",
      "fieldtype": "Datetime",
      "label": "تاريخ الحادث ووقته",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "incident_type",
      "fieldtype": "Select",
      "label": "نوع الحادث",
      "options": "\nAccident\nDamage\nTheft\nFire\nEquipment Failure\nNear Miss\nOther",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "reported_by",
      "fieldtype": "Data",
      "label": "المُبلِّغ",
      "reqd": 1,
      "description": "الشخص الذي أبلغ عن الحادث"
    },
    {
      "fieldname": "injury_involved",
      "fieldtype": "Check",
      "label": "إصابة بشرية"
    },
    {
      "fieldname": "estimated_damage_cost",
      "fieldtype": "Currency",
      "label": "تكلفة الضرر المقدرة"
    },
    {
      "fieldname": "sec_break_desc",
      "fieldtype": "Section Break",
      "label": "وصف الحادث"
    },
    {
      "fieldname": "incident_description",
      "fieldtype": "Text Editor",
      "label": "وصف الحادث",
      "reqd": 1,
      "description": "وصف تفصيلي لما حدث وكيف وقع"
    },
    {
      "fieldname": "sec_break_photos",
      "fieldtype": "Section Break",
      "label": "الصور"
    },
    {
      "fieldname": "photo_1",
      "fieldtype": "Attach Image",
      "label": "صورة 1"
    },
    {
      "fieldname": "col_break_photos",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "photo_2",
      "fieldtype": "Attach Image",
      "label": "صورة 2"
    },
    {
      "fieldname": "sec_break_resolution",
      "fieldtype": "Section Break",
      "label": "الحل والتصحيح"
    },
    {
      "fieldname": "action_taken",
      "fieldtype": "Text Editor",
      "label": "الإجراء الفوري",
      "description": "الخطوات التي اتُّخذت فوراً بعد الحادث"
    },
    {
      "fieldname": "col_break_res",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "resolved_date",
      "fieldtype": "Date",
      "label": "تاريخ الحل"
    },
    {
      "fieldname": "resolved_by",
      "fieldtype": "Data",
      "label": "حُلَّ بواسطة"
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset User", "read": 1, "write": 1, "create": 1}
  ]
}
