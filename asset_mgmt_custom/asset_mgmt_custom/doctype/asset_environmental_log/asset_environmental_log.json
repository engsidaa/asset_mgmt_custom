{
  "doctype": "DocType",
  "name": "Asset Environmental Log",
  "module": "Asset Mgmt Custom",
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "format:ENV-{asset}-{log_date}",
  "fields": [
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "الأصل",
      "options": "Asset",
      "reqd": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "اسم الأصل",
      "fetch_from": "asset.asset_name",
      "read_only": 1
    },
    {
      "fieldname": "log_date",
      "fieldtype": "Date",
      "label": "تاريخ السجل",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "logged_by",
      "fieldtype": "Link",
      "label": "سجَّله",
      "options": "Employee",
      "reqd": 1
    },
    {
      "fieldname": "co2_emissions_kg",
      "fieldtype": "Float",
      "label": "انبعاثات ثاني أكسيد الكربون (كجم)",
      "description": "كمية غاز CO₂ المُنبعَث من تشغيل الأصل"
    },
    {
      "fieldname": "fuel_consumption_liters",
      "fieldtype": "Float",
      "label": "استهلاك الوقود (لتر)"
    },
    {
      "fieldname": "waste_generated_kg",
      "fieldtype": "Float",
      "label": "النفايات المتولّدة (كجم)"
    },
    {
      "fieldname": "water_consumption_liters",
      "fieldtype": "Float",
      "label": "استهلاك المياه (لتر)"
    },
    {
      "fieldname": "noise_level_db",
      "fieldtype": "Float",
      "label": "مستوى الضجيج (ديسيبل)"
    },
    {
      "fieldname": "compliance_standard",
      "fieldtype": "Select",
      "label": "معيار الامتثال",
      "description": "المعيار أو اللائحة التي يتم تقييم الامتثال لها",
      "options": "ISO 14001\nISO 50001\nLocal Regulation\nOther\nNone"
    },
    {
      "fieldname": "is_compliant",
      "fieldtype": "Check",
      "label": "مستوفٍ للمعايير",
      "default": "1"
    },
    {
      "fieldname": "non_compliance_details",
      "fieldtype": "Small Text",
      "label": "تفاصيل عدم الامتثال",
      "description": "وصف الانتهاكات أو الجوانب التي لا تستوفي المعيار",
      "depends_on": "eval:!doc.is_compliant"
    },
    {
      "fieldname": "corrective_action",
      "fieldtype": "Small Text",
      "label": "الإجراء التصحيحي",
      "description": "الخطوات المتخذة لمعالجة حالات عدم الامتثال"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "ملاحظات"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 0,
      "cancel": 0,
      "delete": 1
    }
  ]
}
