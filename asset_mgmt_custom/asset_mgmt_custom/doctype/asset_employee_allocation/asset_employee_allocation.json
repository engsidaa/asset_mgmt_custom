{
 "doctype": "DocType",
 "name": "Asset Employee Allocation",
 "module": "Asset Mgmt Custom",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "is_submittable": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "ALLOC-.YYYY.-",
   "default": "ALLOC-.YYYY.-"
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "options": "Asset",
   "label": "الأصل",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "الحالة",
   "options": "Active\nReturned\nOverdue",
   "default": "Active",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "options": "Branch",
   "label": "Branch",
   "fetch_from": "asset.custom_branch"
  },
  {
   "fieldname": "sec_break_emp",
   "fieldtype": "Section Break",
   "label": "Employee Details"
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "options": "Employee",
   "label": "الموظف",
   "description": "الموظف الذي سيُخصَّص له الأصل",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Employee Name",
   "fetch_from": "employee.employee_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "department",
   "fieldtype": "Link",
   "options": "Department",
   "label": "القسم",
   "fetch_from": "employee.department",
   "read_only": 1
  },
  {
   "fieldname": "allocation_date",
   "fieldtype": "Date",
   "label": "تاريخ التخصيص",
   "description": "تاريخ بدء مسؤولية الموظف عن الأصل",
   "reqd": 1
  },
  {
   "fieldname": "sec_break_dates",
   "fieldtype": "Section Break",
   "label": "Return Details"
  },
  {
   "fieldname": "expected_return_date",
   "fieldtype": "Date",
   "label": "تاريخ الإعادة المتوقع",
   "description": "التاريخ المتوقع لإعادة الأصل",
   "in_list_view": 1
  },
  {
   "fieldname": "purpose",
   "fieldtype": "Text",
   "label": "Purpose / Reason for Allocation"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "return_date",
   "fieldtype": "Date",
   "label": "تاريخ الإعادة الفعلي",
   "read_only": 1
  },
  {
   "fieldname": "condition_on_return",
   "fieldtype": "Select",
   "label": "الحالة عند الإعادة",
   "options": "\nGood\nDamaged\nLost"
  },
  {
   "fieldname": "return_notes",
   "fieldtype": "Text",
   "label": "Return Notes",
   "read_only": 1
  },
  {
   "fieldname": "sec_break_sig",
   "fieldtype": "Section Break",
   "label": "Acknowledgement"
  },
  {
   "fieldname": "signature_attachment",
   "fieldtype": "Attach Image",
   "label": "توقيع الاستلام",
   "description": "صورة توقيع الموظف كإقرار باستلام الأصل"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Assets Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset User",
   "read": 1,
   "print": 1
  }
 ]
}