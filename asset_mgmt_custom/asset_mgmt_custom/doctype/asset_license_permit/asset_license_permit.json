   "reqd": 1
  },
  {
   "fieldname": "renewal_cost",
   "fieldtype": "Currency",
   "label": "Renewal Cost"
  },
  {
   "fieldname": "sec_break_dates",
   "fieldtype": "Section Break",
   "label": "Validity"
  },
  {
   "fieldname": "issue_date",
   "fieldtype": "Date",
   "label": "تاريخ الإصدار",
   "reqd": 1
  },
  {
   "fieldname": "expiry_date",
   "fieldtype": "Date",
   "label": "تاريخ الانتهاء",
   "description": "تاريخ انتهاء صلاحية الترخيص",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "renewal_reminder_days",
   "fieldtype": "Int",
   "label": "أيام التذكير قبل الانتهاء",
   "description": "عدد الأيام التي يُرسَل فيها التنبيه قبل انتهاء الصلاحية",
   "default": "30"
  },
  {
   "fieldname": "sec_break_doc",
   "fieldtype": "Section Break",
   "label": "Documents"
  },
  {
   "fieldname": "permit_document",
   "fieldtype": "Attach",
   "label": "Permit Document"
  },
  {
   "fieldname": "col_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text",
   "label": "ملاحظات"
  }
