   "description": "نوع الوثيقة الرسمية: رخصة، تصريح، شهادة...",
   "options": "\nVehicle License\nOperating Permit\nMunicipal License\nHealth Certificate\nFire Safety Permit\nOther",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "license_number",
   "fieldtype": "Data",
   "label": "رقم الترخيص",
   "description": "الرقم الرسمي للترخيص أو التصريح",
   "reqd": 1,
   "bold": 1
