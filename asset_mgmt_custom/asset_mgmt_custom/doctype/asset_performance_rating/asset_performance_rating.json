{
 "doctype": "DocType",
 "name": "Asset Performance Rating",
 "module": "Asset Mgmt Custom",
 "naming_rule": "Expression",
 "autoname": "format:APR-{asset}-{rating_date}",
 "is_submittable": 0,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "الأصل",
   "options": "Asset",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "label": "الفرع",
   "options": "Branch",
   "fetch_from": "asset.custom_branch",
   "in_list_view": 1
  },
  {
   "fieldname": "overall_rating",
   "fieldtype": "Select",
   "label": "الدرجة الإجمالية",
   "options": "\nExcellent\nGood\nFair\nPoor\nCritical",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1,
   "description": "يُحسب تلقائياً: متوسط جميع الدرجات"
  },
  {
   "fieldname": "sec_break_rating",
   "fieldtype": "Section Break",
   "label": "تفاصيل التقييم"
  },
  {
   "fieldname": "rating_date",
   "fieldtype": "Date",
   "label": "تاريخ التقييم",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "rated_by",
   "fieldtype": "Data",
   "label": "المُقيِّم",
   "reqd": 1,
   "description": "الموظف المسؤول عن تقييم أداء الأصل"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "performance_score",
   "fieldtype": "Float",
   "label": "درجة الأداء",
   "reqd": 1,
   "description": "نقاط من 1 إلى 10 تعبّر عن جودة أداء الأصل"
  },
  {
   "fieldname": "reliability_score",
   "fieldtype": "Float",
   "label": "درجة الموثوقية",
   "description": "نقاط من 1 إلى 10 تعبّر عن موثوقية الأصل"
  },
  {
   "fieldname": "efficiency_score",
   "fieldtype": "Float",
   "label": "درجة الكفاءة",
   "description": "نقاط من 1 إلى 10 تعبّر عن كفاءة الأصل"
  },
  {
   "fieldname": "sec_break_notes",
   "fieldtype": "Section Break",
   "label": "الملاحظات والإجراءات"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text Editor",
   "label": "ملاحظات"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "recommended_action",
   "fieldtype": "Select",
   "label": "الإجراء الموصى به",
   "options": "\nNo Action Needed\nSchedule Maintenance\nIncrease Monitoring\nPlan Replacement\nImmediate Action Required"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset User",
   "read": 1,
   "print": 1
  }
 ]
}