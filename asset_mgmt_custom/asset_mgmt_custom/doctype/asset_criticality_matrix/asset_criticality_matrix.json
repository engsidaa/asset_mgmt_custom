{
  "doctype": "DocType",
  "name": "Asset Criticality Matrix",
  "module": "Asset Mgmt Custom",
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "format:ACM-{asset}",
  "fields": [
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Asset",
      "options": "Asset",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1
    },
    {
      "fieldname": "asset_category",
      "fieldtype": "Link",
      "label": "Asset Category",
      "options": "Asset Category",
      "fetch_from": "asset.asset_category",
      "read_only": 1
    },
    {
      "fieldname": "criticality_level",
      "fieldtype": "Select",
      "label": "Criticality Level",
      "options": "Low\nMedium\nHigh\nCritical",
      "reqd": 1
    },
    {
      "fieldname": "business_impact",
      "fieldtype": "Select",
      "label": "Business Impact if Fails",
      "options": "Minimal\nModerate\nSignificant\nSevere"
    },
    {
      "fieldname": "failure_probability",
      "fieldtype": "Select",
      "label": "Failure Probability",
      "options": "Unlikely\nPossible\nLikely\nAlmost Certain"
    },
    {
      "fieldname": "has_backup",
      "fieldtype": "Check",
      "label": "Has Backup/Standby Asset"
    },
    {
      "fieldname": "backup_asset",
      "fieldtype": "Link",
      "label": "Backup Asset",
      "options": "Asset",
      "depends_on": "has_backup"
    },
    {
      "fieldname": "mttr_hours",
      "fieldtype": "Float",
      "label": "MTTR (Mean Time to Repair) Hours"
    },
    {
      "fieldname": "mtbf_days",
      "fieldtype": "Float",
      "label": "MTBF (Mean Time Between Failures) Days"
    },
    {
      "fieldname": "critical_spare_parts",
      "fieldtype": "Small Text",
      "label": "Critical Spare Parts to Keep"
    },
    {
      "fieldname": "emergency_vendor",
      "fieldtype": "Link",
      "label": "Emergency Vendor",
      "options": "Supplier"
    },
    {
      "fieldname": "recovery_plan",
      "fieldtype": "Text",
      "label": "Recovery/Contingency Plan"
    },
    {
      "fieldname": "last_reviewed",
      "fieldtype": "Date",
      "label": "Last Reviewed"
    },
    {
      "fieldname": "reviewed_by",
      "fieldtype": "Link",
      "label": "Reviewed By",
      "options": "Employee"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 0,
      "cancel": 0,
      "delete": 1
    }
  ]
}
