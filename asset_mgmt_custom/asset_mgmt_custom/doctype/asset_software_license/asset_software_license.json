{
 "doctype": "DocType",
 "name": "Asset Software License",
 "module": "Asset Mgmt Custom",
 "is_submittable": 0,
 "track_changes": 1,
 "naming_rule": "By \"Naming Series\" field",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "SWLIC-.YYYY.-"
  },
  {
   "fieldname": "software_name",
   "fieldtype": "Data",
   "label": "اسم البرنامج",
   "description": "الاسم الرسمي لبرنامج أو نظام التشغيل",
   "reqd": 1
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "options": "Asset",
   "label": "الجهاز المرتبط"
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الجهاز",
   "fetch_from": "asset.asset_name",
   "read_only": 1
  },
  {
   "fieldname": "license_type",
   "fieldtype": "Select",
   "label": "نوع الترخيص",
   "description": "نوع الترخيص: دائم أو اشتراك أو موقع",
   "options": "Perpetual\nSubscription\nSite License\nUser-based\nVolume"
  },
  {
   "fieldname": "license_key",
   "fieldtype": "Data",
   "label": "مفتاح الترخيص",
   "description": "الكود السري للترخيص"
  },
  {
   "fieldname": "vendor",
   "fieldtype": "Link",
   "options": "Supplier",
   "label": "المورد"
  },
  {
   "fieldname": "purchase_date",
   "fieldtype": "Date",
   "label": "تاريخ الشراء"
  },
  {
   "fieldname": "expiry_date",
   "fieldtype": "Date",
   "label": "تاريخ الانتهاء",
   "description": "تاريخ انتهاء صلاحية الترخيص"
  },
  {
   "fieldname": "total_seats",
   "fieldtype": "Int",
   "label": "إجمالي المقاعد/المستخدمين",
   "description": "عدد الأجهزة أو المستخدمين المسموح بهم"
  },
  {
   "fieldname": "used_seats",
   "fieldtype": "Int",
   "label": "المقاعد المستخدمة"
  },
  {
   "fieldname": "annual_cost",
   "fieldtype": "Currency",
   "label": "التكلفة السنوية"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "الحالة",
   "options": "Active\nExpiring Soon\nExpired\nTerminated",
   "default": "Active"
  },
  {
   "fieldname": "renewal_reminder_days",
   "fieldtype": "Int",
   "label": "أيام التذكير قبل الانتهاء",
   "description": "عدد الأيام للتنبيه قبل انتهاء الترخيص",
   "default": "30"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "ملاحظات"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1
  }
 ]
}