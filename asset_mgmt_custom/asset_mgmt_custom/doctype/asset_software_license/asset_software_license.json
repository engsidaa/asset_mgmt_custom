{
  "doctype": "DocType",
  "name": "Asset Software License",
  "module": "Asset Mgmt Custom",
  "is_submittable": 0,
  "track_changes": 1,
  "naming_rule": "By \"Naming Series\" field",
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "SWLIC-.YYYY.-"},
    {"fieldname": "software_name", "fieldtype": "Data", "label": "Software Name", "reqd": 1},
    {"fieldname": "asset", "fieldtype": "Link", "options": "Asset", "label": "Linked Asset (Hardware)"},
    {"fieldname": "asset_name", "fieldtype": "Data", "label": "Asset Name", "fetch_from": "asset.asset_name", "read_only": 1},
    {"fieldname": "license_type", "fieldtype": "Select", "label": "License Type", "options": "Perpetual\nSubscription\nSite License\nUser-based\nVolume"},
    {"fieldname": "license_key", "fieldtype": "Data", "label": "License Key"},
    {"fieldname": "vendor", "fieldtype": "Link", "options": "Supplier", "label": "Vendor"},
    {"fieldname": "purchase_date", "fieldtype": "Date", "label": "Purchase Date"},
    {"fieldname": "expiry_date", "fieldtype": "Date", "label": "Expiry Date"},
    {"fieldname": "total_seats", "fieldtype": "Int", "label": "Total Seats/Users"},
    {"fieldname": "used_seats", "fieldtype": "Int", "label": "Used Seats/Users"},
    {"fieldname": "annual_cost", "fieldtype": "Currency", "label": "Annual Cost"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nExpiring Soon\nExpired\nTerminated", "default": "Active"},
    {"fieldname": "renewal_reminder_days", "fieldtype": "Int", "label": "Renewal Reminder Days", "default": "30"},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 0, "cancel": 0, "delete": 1}
  ]
}
