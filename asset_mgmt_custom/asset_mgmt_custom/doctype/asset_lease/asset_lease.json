{
 "doctype": "DocType",
 "name": "Asset Lease",
 "module": "Asset Mgmt Custom",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "is_submittable": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "LEASE-.YYYY.-",
   "default": "LEASE-.YYYY.-"
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "Asset",
   "options": "Asset",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "Asset Name",
   "fetch_from": "asset.asset_name",
   "read_only": 1
  },
  {
   "fieldname": "col1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lease_type",
   "fieldtype": "Select",
   "label": "Lease Type",
   "options": "\nOperating Lease\nFinance Lease\nRental",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nActive\nExpired\nTerminated",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "section_lessee",
   "fieldtype": "Section Break",
   "label": "Lessee Details"
  },
  {
   "fieldname": "lessee_name",
   "fieldtype": "Data",
   "label": "Lessee Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "lessee_contact",
   "fieldtype": "Data",
   "label": "Contact Number"
  },
  {
   "fieldname": "col2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lessee_type",
   "fieldtype": "Select",
   "label": "Lessee Type",
   "options": "\nInternal (Branch)\nExternal (Third Party)",
   "reqd": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "label": "Internal Branch",
   "options": "Branch",
   "depends_on": "eval:doc.lessee_type === 'Internal (Branch)'"
  },
  {
   "fieldname": "section_terms",
   "fieldtype": "Section Break",
   "label": "Lease Terms"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Lease Start Date",
   "reqd": 1
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "Lease End Date",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "col3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "monthly_rent",
   "fieldtype": "Currency",
   "label": "Monthly Rent / Fee",
   "reqd": 1
  },
  {
   "fieldname": "cost_center",
   "fieldtype": "Link",
   "label": "مركز التكلفة",
   "options": "Cost Center",
   "description": "مركز التكلفة لمصاريف الإيجار."
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency"
  },
  {
   "fieldname": "security_deposit",
   "fieldtype": "Currency",
   "label": "Security Deposit"
  },
  {
   "fieldname": "section_company",
   "fieldtype": "Section Break",
   "label": "Company"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Agreement & Notes",
   "collapsible": 1
  },
  {
   "fieldname": "lease_agreement",
   "fieldtype": "Attach",
   "label": "Lease Agreement (PDF)"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text Editor",
   "label": "Notes"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1
  }
 ],
 "search_fields": "asset, lessee_name, status",
 "title_field": "asset_name",
 "sort_field": "end_date",
 "sort_order": "ASC"
}