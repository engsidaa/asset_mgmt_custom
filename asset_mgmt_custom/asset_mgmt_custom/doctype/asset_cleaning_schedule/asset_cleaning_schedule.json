{
 "doctype": "DocType",
 "name": "Asset Cleaning Schedule",
 "module": "Asset Mgmt Custom",
 "naming_rule": "Expression",
 "autoname": "format:CLEAN-{asset}-{scheduled_date}",
 "is_submittable": 0,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "الأصل",
   "options": "Asset",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "label": "الفرع",
   "options": "Branch",
   "fetch_from": "asset.custom_branch",
   "in_list_view": 1
  },
  {
   "fieldname": "cleaning_type",
   "fieldtype": "Select",
   "label": "نوع التنظيف",
   "options": "\nDaily Clean\nDeep Clean\nSanitization\nDescaling\nFilter Clean\nOther",
   "reqd": 1,
   "in_list_view": 1,
   "description": "نوع عملية التنظيف: يومي، أسبوعي، عميق..."
  },
  {
   "fieldname": "sec_break_schedule",
   "fieldtype": "Section Break",
   "label": "الجدول الزمني"
  },
  {
   "fieldname": "scheduled_date",
   "fieldtype": "Date",
   "label": "التاريخ المحدد",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1,
   "description": "التاريخ المجدول لتنفيذ عملية التنظيف"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Data",
   "label": "المسؤول",
   "reqd": 1,
   "description": "الموظف المكلف بتنفيذ التنظيف"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "الحالة",
   "options": "Scheduled\nCompleted\nMissed\nSkipped",
   "default": "Scheduled",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1,
   "description": "مجدول / منجز / فائت / مُلغى"
  },
  {
   "fieldname": "completed_date",
   "fieldtype": "Date",
   "label": "تاريخ الإنجاز",
   "depends_on": "eval:doc.status === 'Completed'"
  },
  {
   "fieldname": "sec_break_notes",
   "fieldtype": "Section Break",
   "label": "ملاحظات"
  },
  {
   "fieldname": "cleaning_notes",
   "fieldtype": "Text",
   "label": "ملاحظات"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "verified_by",
   "fieldtype": "Data",
   "label": "تم التحقق بواسطة"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Employee",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}