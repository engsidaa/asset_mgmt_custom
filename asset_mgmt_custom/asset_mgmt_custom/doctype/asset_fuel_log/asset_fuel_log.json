   "read_only": 1
  },
  {
   "fieldname": "fuel_type",
   "fieldtype": "Select",
   "label": "نوع الوقود",
   "options": "\nDiesel\nPetrol\nNatural Gas\nElectric",
   "reqd": 1
  },
  {
   "fieldname": "sec_break_fuel",
   "fieldtype": "Section Break",
   "label": "Fuel Details"
  },
  {
   "fieldname": "liters_filled",
   "fieldtype": "Float",
   "label": "كمية الوقود (لتر)",
   "description": "كمية الوقود التي تم تعبئتها",
   "reqd": 1
  },
  {
   "fieldname": "unit_cost",
   "fieldtype": "Currency",
   "label": "تكلفة اللتر"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_cost",
   "fieldtype": "Currency",
   "label": "التكلفة الإجمالية",
   "description": "يُحسب تلقائياً: الكمية × السعر",
   "read_only": 1
  },
  {
   "fieldname": "fuel_vendor",
   "fieldtype": "Data",
   "label": "Fuel Station / Vendor"
  },
  {
   "fieldname": "sec_break_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text",
   "label": "ملاحظات"
  }
 ],
