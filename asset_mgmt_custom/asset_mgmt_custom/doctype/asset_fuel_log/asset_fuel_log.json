  },
  {
   "fieldname": "closing_meter",
   "fieldtype": "Float",
   "label": "قراءة العداد - النهاية",
   "description": "قراءة عداد المسافة في نهاية الرحلة/الفترة"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "km_driven",
   "fieldtype": "Float",
   "label": "المسافة المقطوعة (كم)",
