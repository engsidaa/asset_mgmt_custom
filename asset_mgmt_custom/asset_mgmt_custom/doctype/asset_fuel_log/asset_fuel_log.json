{
 "doctype": "DocType",
 "name": "Asset Fuel Log",
 "module": "Asset Mgmt Custom",
 "naming_rule": "Expression",
 "autoname": "format:FUEL-{asset}-{log_date}",
 "is_submittable": 0,
 "track_changes": 0,
 "fields": [
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "options": "Asset",
   "label": "الأصل",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "options": "Branch",
   "label": "الفرع",
   "fetch_from": "asset.custom_branch",
   "in_list_view": 1
  },
  {
   "fieldname": "log_date",
   "fieldtype": "Date",
   "label": "تاريخ السجل",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "vehicle_reg_no",
   "fieldtype": "Data",
   "label": "Vehicle/Equipment Reg No"
  },
  {
   "fieldname": "sec_break_readings",
   "fieldtype": "Section Break",
   "label": "Meter Readings"
  },
  {
   "fieldname": "opening_meter",
   "fieldtype": "Float",
   "label": "قراءة العداد - البداية",
