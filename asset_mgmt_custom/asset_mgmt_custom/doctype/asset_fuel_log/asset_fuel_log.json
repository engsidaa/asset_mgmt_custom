{
  "doctype": "DocType",
  "name": "Asset Fuel Log",
  "module": "Asset Mgmt Custom",
  "naming_rule": "Expression",
  "autoname": "format:FUEL-{asset}-{log_date}",
  "is_submittable": 0,
  "track_changes": 0,
  "fields": [
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "options": "Asset",
      "label": "Asset",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "options": "Branch",
      "label": "Branch",
      "fetch_from": "asset.custom_branch",
      "in_list_view": 1
    },
    {
      "fieldname": "log_date",
      "fieldtype": "Date",
      "label": "Log Date",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "vehicle_reg_no",
      "fieldtype": "Data",
      "label": "Vehicle/Equipment Reg No"
    },
    {
      "fieldname": "sec_break_readings",
      "fieldtype": "Section Break",
      "label": "Meter Readings"
    },
    {
      "fieldname": "opening_meter",
      "fieldtype": "Float",
      "label": "Opening Meter (km/hrs)"
    },
    {
      "fieldname": "closing_meter",
      "fieldtype": "Float",
      "label": "Closing Meter (km/hrs)"
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "km_driven",
      "fieldtype": "Float",
      "label": "Distance / Hours",
      "read_only": 1
    },
    {
      "fieldname": "fuel_type",
      "fieldtype": "Select",
      "label": "Fuel Type",
      "options": "\nDiesel\nPetrol\nNatural Gas\nElectric",
      "reqd": 1
    },
    {
      "fieldname": "sec_break_fuel",
      "fieldtype": "Section Break",
      "label": "Fuel Details"
    },
    {
      "fieldname": "liters_filled",
      "fieldtype": "Float",
      "label": "Liters Filled",
      "reqd": 1
    },
    {
      "fieldname": "unit_cost",
      "fieldtype": "Currency",
      "label": "Cost per Liter"
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "total_cost",
      "fieldtype": "Currency",
      "label": "Total Cost",
      "read_only": 1
    },
    {
      "fieldname": "fuel_vendor",
      "fieldtype": "Data",
      "label": "Fuel Station / Vendor"
    },
    {
      "fieldname": "sec_break_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Asset Manager",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Asset User",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
