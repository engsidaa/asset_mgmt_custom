{
 "doctype": "DocType",
 "name": "Asset Return Request",
 "module": "Asset Mgmt Custom",
 "is_submittable": 1,
 "track_changes": 1,
 "naming_rule": "By \"Naming Series\" field",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "ARR-.YYYY.-"
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "options": "Asset",
   "label": "الأصل",
   "reqd": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1
  },
  {
   "fieldname": "current_custodian",
   "fieldtype": "Link",
   "options": "Employee",
   "label": "الحارس الحالي",
   "description": "الموظف المسؤول عن الأصل حالياً",
   "reqd": 1
  },
  {
   "fieldname": "department",
   "fieldtype": "Link",
   "options": "Department",
   "label": "القسم",
   "fetch_from": "current_custodian.department",
   "read_only": 1
  },
  {
   "fieldname": "return_reason",
   "fieldtype": "Select",
   "label": "سبب الإعادة",
   "description": "السبب الرئيسي لإعادة الأصل",
   "options": "End of Use\nDamaged\nTransferred\nEmployee Exit\nUpgrade\nOther",
   "reqd": 1
  },
  {
   "fieldname": "request_date",
   "fieldtype": "Date",
   "label": "تاريخ الطلب",
   "reqd": 1,
   "default": "Today"
  },
  {
   "fieldname": "expected_return_date",
   "fieldtype": "Date",
   "label": "التاريخ المتوقع للإعادة"
  },
  {
   "fieldname": "actual_return_date",
   "fieldtype": "Date",
   "label": "تاريخ الإعادة الفعلي",
   "read_only": 1
  },
  {
   "fieldname": "condition_at_return",
   "fieldtype": "Select",
   "label": "حالة الأصل عند الإعادة",
   "description": "تقييم حالة الأصل لحظة الاستلام",
   "options": "Excellent\nGood\nFair\nDamaged\nBeyond Repair"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "الحالة",
   "options": "Pending\nApproved\nReturned\nRejected",
   "default": "Pending"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "ملاحظات"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Assets Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Employee",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}