{
 "doctype": "DocType",
 "name": "Asset Condition Assessment",
 "module": "Asset Mgmt Custom",
 "is_submittable": 0,
 "track_changes": 1,
 "naming_rule": "Expression",
 "autoname": "format:ACA-{asset}-{assessment_date}",
 "fields": [
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "options": "Asset",
   "label": "الأصل",
   "reqd": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "options": "Branch",
   "label": "الفرع",
   "fetch_from": "asset.branch",
   "read_only": 1
  },
  {
   "fieldname": "assessment_date",
   "fieldtype": "Date",
   "label": "تاريخ التقييم",
   "reqd": 1,
   "default": "Today"
  },
  {
   "fieldname": "assessed_by",
   "fieldtype": "Link",
   "options": "Employee",
   "label": "المقيّم",
   "description": "الموظف المسؤول عن تقييم حالة الأصل",
   "reqd": 1
  },
  {
   "fieldname": "overall_condition",
   "fieldtype": "Select",
   "label": "الحالة العامة",
   "description": "التقييم الإجمالي للأصل",
   "options": "Excellent\nGood\nFair\nPoor\nCritical",
   "reqd": 1
  },
  {
   "fieldname": "condition_details_section",
   "fieldtype": "Section Break",
   "label": "تفاصيل الحالة"
  },
  {
   "fieldname": "structural_condition",
   "fieldtype": "Select",
   "label": "الحالة الهيكلية",
   "description": "حالة البنية الجسدية للأصل",
   "options": "Excellent\nGood\nFair\nPoor\nCritical"
  },
  {
   "fieldname": "functional_condition",
   "fieldtype": "Select",
   "label": "الحالة الوظيفية",
   "description": "مدى عمل الأصل بكفاءة",
   "options": "Excellent\nGood\nFair\nPoor\nCritical"
  },
  {
   "fieldname": "aesthetic_condition",
   "fieldtype": "Select",
   "label": "الحالة المظهرية",
   "description": "الحالة الشكلية والجمالية",
   "options": "Excellent\nGood\nFair\nPoor\nCritical"
  },
  {
   "fieldname": "safety_condition",
   "fieldtype": "Select",
   "label": "حالة السلامة",
   "description": "مدى الأمان عند استخدام الأصل",
   "options": "Excellent\nGood\nFair\nPoor\nCritical"
  },
  {
   "fieldname": "action_required_section",
   "fieldtype": "Section Break",
   "label": "الإجراءات المقترحة"
  },
  {
   "fieldname": "requires_maintenance",
   "fieldtype": "Check",
   "label": "يحتاج صيانة"
  },
  {
   "fieldname": "requires_repair",
   "fieldtype": "Check",
   "label": "يحتاج إصلاح"
  },
  {
   "fieldname": "recommend_disposal",
   "fieldtype": "Check",
   "label": "يُوصى بالتخلص منه"
  },
  {
   "fieldname": "next_assessment_date",
   "fieldtype": "Date",
   "label": "تاريخ التقييم القادم"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Text",
   "label": "الملاحظات والمشاهدات"
  },
  {
   "fieldname": "photo_attachment",
   "fieldtype": "Attach Image",
   "label": "صورة الأصل"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Assets Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1
  }
 ]
}