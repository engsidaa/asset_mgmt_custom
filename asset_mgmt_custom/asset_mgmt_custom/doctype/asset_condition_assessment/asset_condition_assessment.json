{
  "doctype": "DocType",
  "name": "Asset Condition Assessment",
  "module": "Asset Mgmt Custom",
  "is_submittable": 0,
  "track_changes": 1,
  "naming_rule": "Expression",
  "autoname": "format:ACA-{asset}-{assessment_date}",
  "fields": [
    {"fieldname": "asset", "fieldtype": "Link", "options": "Asset", "label": "Asset", "reqd": 1},
    {"fieldname": "asset_name", "fieldtype": "Data", "label": "Asset Name", "fetch_from": "asset.asset_name", "read_only": 1},
    {"fieldname": "branch", "fieldtype": "Link", "options": "Branch", "label": "Branch", "fetch_from": "asset.branch", "read_only": 1},
    {"fieldname": "assessment_date", "fieldtype": "Date", "label": "Assessment Date", "reqd": 1, "default": "Today"},
    {"fieldname": "assessed_by", "fieldtype": "Link", "options": "Employee", "label": "Assessed By", "reqd": 1},
    {"fieldname": "overall_condition", "fieldtype": "Select", "label": "Overall Condition", "options": "Excellent\nGood\nFair\nPoor\nCritical", "reqd": 1},
    {"fieldname": "condition_details_section", "fieldtype": "Section Break", "label": "Condition Details"},
    {"fieldname": "structural_condition", "fieldtype": "Select", "label": "Structural Condition", "options": "Excellent\nGood\nFair\nPoor\nCritical"},
    {"fieldname": "functional_condition", "fieldtype": "Select", "label": "Functional Condition", "options": "Excellent\nGood\nFair\nPoor\nCritical"},
    {"fieldname": "aesthetic_condition", "fieldtype": "Select", "label": "Aesthetic Condition", "options": "Excellent\nGood\nFair\nPoor\nCritical"},
    {"fieldname": "safety_condition", "fieldtype": "Select", "label": "Safety Condition", "options": "Excellent\nGood\nFair\nPoor\nCritical"},
    {"fieldname": "action_required_section", "fieldtype": "Section Break", "label": "Action Required"},
    {"fieldname": "requires_maintenance", "fieldtype": "Check", "label": "Requires Maintenance"},
    {"fieldname": "requires_repair", "fieldtype": "Check", "label": "Requires Repair"},
    {"fieldname": "recommend_disposal", "fieldtype": "Check", "label": "Recommend Disposal"},
    {"fieldname": "next_assessment_date", "fieldtype": "Date", "label": "Next Assessment Date"},
    {"fieldname": "remarks", "fieldtype": "Text", "label": "Remarks & Observations"},
    {"fieldname": "photo_attachment", "fieldtype": "Attach Image", "label": "Photo"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 0, "cancel": 0, "delete": 1}
  ]
}
