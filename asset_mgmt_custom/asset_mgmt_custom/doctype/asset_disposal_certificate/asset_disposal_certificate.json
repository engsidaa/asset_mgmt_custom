{
  "doctype": "DocType",
  "name": "Asset Disposal Certificate",
  "module": "Asset Mgmt Custom",
  "is_submittable": 1,
  "track_changes": 1,
  "autoname": "naming_series:",
  "naming_series": "DCERT-.YYYY.-",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "السلسلة",
      "options": "DCERT-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "الأصل",
      "options": "Asset",
      "reqd": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "اسم الأصل",
      "fetch_from": "asset.asset_name",
      "read_only": 1
    },
    {
      "fieldname": "asset_category",
      "fieldtype": "Link",
      "label": "فئة الأصل",
      "options": "Asset Category",
      "fetch_from": "asset.asset_category",
      "read_only": 1
    },
    {
      "fieldname": "disposal_date",
      "fieldtype": "Date",
      "label": "تاريخ التخلص",
      "reqd": 1
    },
    {
      "fieldname": "disposal_method",
      "fieldtype": "Select",
      "label": "أسلوب التخلص",
      "options": "Sold\nScrapped\nDonated\nTransferred\nDestroyed",
      "reqd": 1
    },
    {
      "fieldname": "disposal_value",
      "fieldtype": "Currency",
      "label": "قيمة التخلص/الإنقاذ",
      "description": "المبلغ المحصَّل أو القيمة التقديرية للأصل عند التخلص"
    },
    {
      "fieldname": "disposed_by",
      "fieldtype": "Link",
      "label": "نفَّذه",
      "options": "Employee",
      "reqd": 1
    },
    {
      "fieldname": "authorized_by",
      "fieldtype": "Link",
      "label": "مُخوَّل من",
      "description": "الشخص الذي اعتمد إجراء التخلص",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "buyer_name",
      "fieldtype": "Data",
      "label": "اسم المشتري/المستفيد",
      "depends_on": "eval:in_list(['Sold','Donated','Transferred'], doc.disposal_method)"
    },
    {
      "fieldname": "certificate_number",
      "fieldtype": "Data",
      "label": "رقم الشهادة",
      "description": "يُولَّد تلقائياً عند الإرسال",
      "read_only": 1
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "ملاحظات"
    },
    {
      "fieldname": "attachment",
      "fieldtype": "Attach",
      "label": "وثيقة داعمة"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "delete": 1
    }
  ]
}
