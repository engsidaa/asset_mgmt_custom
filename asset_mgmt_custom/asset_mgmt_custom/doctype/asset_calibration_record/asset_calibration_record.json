{
  "doctype": "DocType",
  "name": "Asset Calibration Record",
  "module": "Asset Mgmt Custom",
  "naming_rule": "Expression",
  "autoname": "format:CAL-{asset}-{calibration_date}",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "options": "Asset",
      "label": "الأصل",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "اسم الأصل",
      "fetch_from": "asset.asset_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "options": "Branch",
      "label": "Branch",
      "fetch_from": "asset.custom_branch",
      "in_list_view": 1
    },
    {
      "fieldname": "asset_category",
      "fieldtype": "Link",
      "options": "Asset Category",
      "label": "Asset Category",
      "fetch_from": "asset.asset_category",
      "read_only": 1
    },
    {
      "fieldname": "sec_break_cal",
      "fieldtype": "Section Break",
      "label": "Calibration Details"
    },
    {
      "fieldname": "calibration_date",
      "fieldtype": "Date",
      "label": "تاريخ المعايرة",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "next_calibration_date",
      "fieldtype": "Date",
      "label": "تاريخ المعايرة القادمة",
      "description": "الموعد المحدد للمعايرة التالية",
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "calibrated_by",
      "fieldtype": "Data",
      "label": "المعايِر",
      "description": "الشركة أو الموظف المسؤول عن المعايرة",
      "reqd": 1
    },
    {
      "fieldname": "calibration_standard",
      "fieldtype": "Data",
      "label": "معيار المعايرة",
      "description": "المعيار أو المواصفة المستخدمة في المعايرة"
    },
    {
      "fieldname": "sec_break_result",
      "fieldtype": "Section Break",
      "label": "Result"
    },
    {
      "fieldname": "result",
      "fieldtype": "Select",
      "label": "نتيجة المعايرة",
      "description": "هل اجتاز الأصل المعايرة أم لا",
      "options": "\nPass\nFail\nAdjusted",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "certificate_number",
      "fieldtype": "Data",
      "label": "رقم شهادة المعايرة"
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "calibration_cost",
      "fieldtype": "Currency",
      "label": "Calibration Cost"
    },
    {
      "fieldname": "calibration_document",
      "fieldtype": "Attach",
      "label": "Calibration Certificate"
    },
    {
      "fieldname": "sec_break_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "ملاحظات"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Asset Manager",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Asset User",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
