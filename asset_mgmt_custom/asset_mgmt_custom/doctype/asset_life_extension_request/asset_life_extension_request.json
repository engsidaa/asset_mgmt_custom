{
 "doctype": "DocType",
 "name": "Asset Life Extension Request",
 "module": "Asset Mgmt Custom",
 "is_submittable": 1,
 "track_changes": 1,
 "autoname": "naming_series:",
 "naming_series": "LER-.YYYY.-",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "السلسلة",
   "options": "LER-.YYYY.-"
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "الأصل",
   "options": "Asset",
   "reqd": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1
  },
  {
   "fieldname": "current_expected_disposal_date",
   "fieldtype": "Date",
   "label": "تاريخ التخلص الحالي المتوقع",
   "read_only": 1,
   "description": "يُحسَب تلقائياً من بيانات الإهلاك الحالية (تاريخ بدء الاستخدام + مدة الإهلاك المتبقية) — وليس من Asset.disposal_date الذي يبقى فارغاً حتى يُتخلَّص من الأصل فعلياً"
  },
  {
   "fieldname": "requested_by",
   "fieldtype": "Link",
   "label": "مقدِّم الطلب",
   "options": "Employee",
   "reqd": 1
  },
  {
   "fieldname": "request_date",
   "fieldtype": "Date",
   "label": "تاريخ الطلب",
   "reqd": 1,
   "default": "Today"
  },
  {
   "fieldname": "requested_extension_years",
   "fieldtype": "Float",
   "label": "مدة التمديد المطلوبة (سنوات)",
   "description": "عدد السنوات التي يُطلب تمديد عمر الأصل بها",
   "reqd": 1
  },
  {
   "fieldname": "new_expected_disposal_date",
   "fieldtype": "Date",
   "label": "تاريخ التخلص المقترح الجديد",
   "reqd": 1
  },
  {
   "fieldname": "justification",
   "fieldtype": "Text",
   "label": "مبرر الطلب",
   "description": "الأسباب التقنية والاقتصادية لتمديد عمر الأصل",
   "reqd": 1
  },
  {
   "fieldname": "condition_report",
   "fieldtype": "Small Text",
   "label": "تقرير الحالة الحالية",
   "description": "وصف مختصر للحالة الراهنة للأصل"
  },
  {
   "fieldname": "estimated_extension_cost",
   "fieldtype": "Currency",
   "label": "تكلفة التمديد التقديرية",
   "description": "التكاليف المتوقعة للحفاظ على الأصل لفترة إضافية"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "الحالة",
   "options": "Pending\nApproved\nRejected",
   "default": "Pending"
  },
  {
   "fieldname": "decision_notes",
   "fieldtype": "Small Text",
   "label": "ملاحظات القرار"
  },
  {
   "fieldname": "resulting_asset_repair",
   "fieldtype": "Link",
   "label": "سجل الإصلاح الناتج (تمديد فعلي)",
   "options": "Asset Repair",
   "read_only": 1,
   "allow_on_submit": 1,
   "description": "يُنشأ ويُسلَّم تلقائياً عند تسليم هذا الطلب — هو من يُنفِّذ فعلياً رسملة التكلفة وإعادة جدولة الإهلاك بالعمر الإنتاجي الجديد"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1
  }
 ]
}