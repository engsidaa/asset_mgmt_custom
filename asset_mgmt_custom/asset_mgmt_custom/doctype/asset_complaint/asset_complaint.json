{
 "doctype": "DocType",
 "name": "Asset Complaint",
 "module": "Asset Mgmt Custom",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "is_submittable": 0,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "COMP-.YYYY.-",
   "default": "COMP-.YYYY.-"
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "options": "Asset",
   "label": "الأصل",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "الحالة",
   "description": "مفتوحة / قيد المعالجة / محلولة / مغلقة",
   "options": "Open\nIn Progress\nResolved\nClosed",
   "default": "Open",
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "options": "Branch",
   "label": "Branch",
   "fetch_from": "asset.custom_branch",
   "in_list_view": 1
  },
  {
   "fieldname": "sec_break_comp",
   "fieldtype": "Section Break",
   "label": "Complaint Details"
  },
  {
   "fieldname": "complaint_date",
   "fieldtype": "Date",
   "label": "تاريخ الشكوى",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "reported_by",
   "fieldtype": "Data",
   "label": "مقدِّم الشكوى",
   "description": "الشخص أو الجهة التي قدمت الشكوى",
   "reqd": 1
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "complaint_type",
   "fieldtype": "Select",
   "label": "Complaint Type",
   "options": "\nPerformance Issue\nDamage\nMissing Part\nNoise\nSafety Concern\nOther",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "priority",
   "fieldtype": "Select",
   "label": "الأولوية",
   "description": "درجة أهمية الشكوى: منخفضة، متوسطة، عالية، عاجلة",
   "options": "Low\nMedium\nHigh\nUrgent",
   "default": "Medium",
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "sec_break_desc",
   "fieldtype": "Section Break",
   "label": "Description"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "وصف الشكوى",
   "description": "تفصيل المشكلة أو التقصير الذي تم إبلاغه",
   "reqd": 1
  },
  {
   "fieldname": "sec_break_resolution",
   "fieldtype": "Section Break",
   "label": "Resolution"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Data",
   "label": "Assigned To"
  },
  {
   "fieldname": "resolution_date",
   "fieldtype": "Date",
   "label": "تاريخ الحل"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "resolution_notes",
   "fieldtype": "Text Editor",
   "label": "الحل المقدم",
   "description": "الخطوات التي اتُّخذت لحل الشكوى"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset User",
   "read": 1,
   "create": 1,
   "print": 1
  }
 ]
}