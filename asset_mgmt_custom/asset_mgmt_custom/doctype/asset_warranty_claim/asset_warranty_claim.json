{
  "doctype": "DocType",
  "name": "Asset Warranty Claim",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "options": "WARR-.YYYY.-",
      "default": "WARR-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Asset",
      "options": "Asset",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Open\nSubmitted\nIn Progress\nResolved\nRejected",
      "default": "Open",
      "read_only": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "supplier",
      "fieldtype": "Link",
      "label": "Supplier",
      "options": "Supplier",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sec_break_claim",
      "fieldtype": "Section Break",
      "label": "Claim Details"
    },
    {
      "fieldname": "claim_date",
      "fieldtype": "Date",
      "label": "Claim Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warranty_expiry_date",
      "fieldtype": "Date",
      "label": "Warranty Expiry Date",
      "reqd": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "claim_reference",
      "fieldtype": "Data",
      "label": "Claim Reference"
    },
    {
      "fieldname": "issue_description",
      "fieldtype": "Text Editor",
      "label": "Issue Description",
      "reqd": 1
    },
    {
      "fieldname": "sec_break_resolution",
      "fieldtype": "Section Break",
      "label": "Resolution"
    },
    {
      "fieldname": "resolution_date",
      "fieldtype": "Date",
      "label": "Resolution Date"
    },
    {
      "fieldname": "resolution_type",
      "fieldtype": "Select",
      "label": "Resolution Type",
      "options": "\nRepaired\nReplaced\nRefunded\nRejected"
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "replacement_asset",
      "fieldtype": "Link",
      "label": "Replacement Asset",
      "options": "Asset"
    },
    {
      "fieldname": "resolution_notes",
      "fieldtype": "Text Editor",
      "label": "Resolution Notes"
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset User", "read": 1, "write": 1, "create": 1}
  ]
}
