{
 "doctype": "DocType",
 "name": "Asset Transfer Request",
 "module": "Asset Mgmt Custom",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "is_submittable": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "سلسلة الترقيم",
   "options": "ATR-.YYYY.-",
   "default": "ATR-.YYYY.-"
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "الأصل",
   "options": "Asset",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "الحالة",
   "options": "Pending\nApproved\nRejected\nCompleted",
   "default": "Pending",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "طالب النقل",
   "options": "Employee",
   "reqd": 1
  },
  {
   "fieldname": "sec_break_transfer",
   "fieldtype": "Section Break",
   "label": "تفاصيل النقل"
  },
  {
   "fieldname": "from_branch",
   "fieldtype": "Link",
   "label": "الفرع المُرسِل",
   "options": "Branch",
   "reqd": 1,
   "in_list_view": 1,
   "fetch_from": "asset.custom_branch",
   "description": "الفرع الذي ينقل منه الأصل"
  },
  {
   "fieldname": "to_branch",
   "fieldtype": "Link",
   "label": "الفرع المستقبِل",
   "options": "Branch",
   "reqd": 1,
   "in_list_view": 1,
   "description": "الفرع الذي سيُستلَم فيه الأصل"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "transfer_date",
   "fieldtype": "Date",
   "label": "تاريخ النقل المطلوب",
   "reqd": 1
  },
  {
   "fieldname": "reason",
   "fieldtype": "Text",
   "label": "سبب النقل",
   "reqd": 1,
   "description": "المبرر الرئيسي لطلب نقل الأصل"
  },
  {
   "fieldname": "sec_break_approval",
   "fieldtype": "Section Break",
   "label": "الموافقة"
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Data",
   "label": "المعتمد من",
   "read_only": 1
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Text",
   "label": "سبب الرفض",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Assets Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Employee",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}