{
  "doctype": "DocType",
  "name": "Asset Transfer Request",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "options": "ATR-.YYYY.-",
      "default": "ATR-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Asset",
      "options": "Asset",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending\nApproved\nRejected\nCompleted",
      "default": "Pending",
      "read_only": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Requested By",
      "options": "Employee",
      "reqd": 1
    },
    {
      "fieldname": "sec_break_transfer",
      "fieldtype": "Section Break",
      "label": "Transfer Details"
    },
    {
      "fieldname": "from_branch",
      "fieldtype": "Link",
      "label": "From Branch",
      "options": "Branch",
      "reqd": 1,
      "in_list_view": 1,
      "fetch_from": "asset.custom_branch"
    },
    {
      "fieldname": "to_branch",
      "fieldtype": "Link",
      "label": "To Branch",
      "options": "Branch",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "transfer_date",
      "fieldtype": "Date",
      "label": "Requested Transfer Date",
      "reqd": 1
    },
    {
      "fieldname": "reason",
      "fieldtype": "Text",
      "label": "Reason for Transfer",
      "reqd": 1
    },
    {
      "fieldname": "sec_break_approval",
      "fieldtype": "Section Break",
      "label": "Approval"
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": 1
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "rejection_reason",
      "fieldtype": "Text",
      "label": "Rejection Reason",
      "read_only": 1
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset User", "read": 1, "write": 1, "create": 1}
  ]
}
