{
  "doctype": "DocType",
  "name": "Asset Spare Part",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "options": "SPARE-.YYYY.-",
      "default": "SPARE-.YYYY.-"
    },
    {
      "fieldname": "item_name",
      "fieldtype": "Data",
      "label": "Part Name",
      "reqd": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_category",
      "fieldtype": "Link",
      "label": "Asset Category",
      "options": "Asset Category",
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "quantity",
      "fieldtype": "Float",
      "label": "Current Quantity",
      "reqd": 1,
      "in_list_view": 1,
      "default": "0"
    },
    {
      "fieldname": "minimum_qty",
      "fieldtype": "Float",
      "label": "Minimum Quantity",
      "in_list_view": 1,
      "default": "1"
    },
    {
      "fieldname": "unit",
      "fieldtype": "Data",
      "label": "Unit of Measure",
      "default": "Nos"
    },
    {
      "fieldname": "sec_break_location",
      "fieldtype": "Section Break",
      "label": "Storage & Supplier"
    },
    {
      "fieldname": "location",
      "fieldtype": "Link",
      "label": "Storage Location",
      "options": "Location"
    },
    {
      "fieldname": "supplier",
      "fieldtype": "Link",
      "label": "Supplier",
      "options": "Supplier"
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "unit_cost",
      "fieldtype": "Currency",
      "label": "Unit Cost"
    },
    {
      "fieldname": "last_replenished",
      "fieldtype": "Date",
      "label": "Last Replenished"
    },
    {
      "fieldname": "sec_break_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Asset Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Asset User", "read": 1}
  ]
}
