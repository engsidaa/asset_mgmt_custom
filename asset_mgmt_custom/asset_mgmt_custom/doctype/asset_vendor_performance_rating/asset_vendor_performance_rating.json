{
 "doctype": "DocType",
 "name": "Asset Vendor Performance Rating",
 "module": "Asset Mgmt Custom",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "is_submittable": 0,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "سلسلة الترقيم",
   "options": "VPR-.YYYY.-.####",
   "default": "VPR-.YYYY.-.####"
  },
  {
   "fieldname": "supplier",
   "fieldtype": "Link",
   "label": "المورد",
   "options": "Supplier",
   "reqd": 1,
   "bold": 1,
   "in_list_view": 1,
   "search_index": 1,
   "description": "المورد أو شركة الصيانة التي يُجرى لها التقييم"
  },
  {
   "fieldname": "contract",
   "fieldtype": "Link",
   "label": "العقد",
   "options": "Asset Vendor Contract",
   "description": "عقد المورد المرتبط بهذا التقييم"
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "rating_period",
   "fieldtype": "Select",
   "label": "فترة التقييم",
   "reqd": 1,
   "options": "ربع سنوي\nنصف سنوي\nسنوي",
   "description": "الفترة الزمنية التي يغطيها هذا التقييم"
  },
  {
   "fieldname": "rating_date",
   "fieldtype": "Date",
   "label": "تاريخ التقييم",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "rated_by",
   "fieldtype": "Link",
   "label": "المقيِّم",
   "options": "User",
   "description": "الموظف المسؤول عن إجراء تقييم المورد"
  },
  {
   "fieldname": "sec_break_scores",
   "fieldtype": "Section Break",
   "label": "معايير التقييم (1 = ضعيف، 5 = ممتاز)"
  },
  {
   "fieldname": "response_time_score",
   "fieldtype": "Int",
   "label": "سرعة الاستجابة",
   "reqd": 1,
   "description": "مدى سرعة المورد في الاستجابة للطلبات والطوارئ"
  },
  {
   "fieldname": "quality_score",
   "fieldtype": "Int",
   "label": "جودة العمل",
   "reqd": 1,
   "description": "مستوى جودة الأعمال والخدمات المقدمة"
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "timeliness_score",
   "fieldtype": "Int",
   "label": "الالتزام بالمواعيد",
   "reqd": 1,
   "description": "مدى التزام المورد بالجداول الزمنية المتفق عليها"
  },
  {
   "fieldname": "pricing_score",
   "fieldtype": "Int",
   "label": "مستوى التسعير",
   "reqd": 1,
   "description": "معقولية الأسعار مقارنةً بالجودة والسوق"
  },
  {
   "fieldname": "communication_score",
   "fieldtype": "Int",
   "label": "مستوى التواصل",
   "reqd": 1,
   "description": "وضوح التواصل والشفافية وسهولة التعامل"
  },
  {
   "fieldname": "sec_break_result",
   "fieldtype": "Section Break",
   "label": "نتيجة التقييم"
  },
  {
   "fieldname": "overall_score",
   "fieldtype": "Float",
   "label": "الدرجة الإجمالية",
   "read_only": 1,
   "in_list_view": 1,
   "description": "متوسط درجات جميع المعايير (يُحسَب تلقائياً)"
  },
  {
   "fieldname": "recommendation",
   "fieldtype": "Select",
   "label": "التوصية",
   "options": "تجديد العقد\nمراجعة الشروط\nإنذار رسمي\nإنهاء العقد",
   "in_list_view": 1,
   "description": "التوصية المبنية على نتيجة التقييم"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Long Text",
   "label": "ملاحظات",
   "description": "تفاصيل إضافية أو تعليقات حول أداء المورد"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Assets Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1
  }
 ]
}