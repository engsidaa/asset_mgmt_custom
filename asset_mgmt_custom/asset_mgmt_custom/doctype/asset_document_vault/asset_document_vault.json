{
  "doctype": "DocType",
  "name": "Asset Document Vault",
  "module": "Asset Mgmt Custom",
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "naming_series:",
  "naming_series": "ADOC-.YYYY.-",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "ADOC-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Asset",
      "options": "Asset",
      "reqd": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1
    },
    {
      "fieldname": "document_type",
      "fieldtype": "Select",
      "label": "Document Type",
      "options": "Invoice\nWarranty Card\nInsurance Policy\nMaintenance Contract\nCertificate\nManual\nPhoto\nOther",
      "reqd": 1
    },
    {
      "fieldname": "document_title",
      "fieldtype": "Data",
      "label": "Document Title",
      "reqd": 1
    },
    {
      "fieldname": "document_date",
      "fieldtype": "Date",
      "label": "Document Date"
    },
    {
      "fieldname": "expiry_date",
      "fieldtype": "Date",
      "label": "Expiry Date"
    },
    {
      "fieldname": "document_file",
      "fieldtype": "Attach",
      "label": "Document File",
      "reqd": 1
    },
    {
      "fieldname": "issued_by",
      "fieldtype": "Data",
      "label": "Issued By"
    },
    {
      "fieldname": "reference_number",
      "fieldtype": "Data",
      "label": "Reference Number"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 0,
      "cancel": 0,
      "delete": 1
    }
  ]
}
