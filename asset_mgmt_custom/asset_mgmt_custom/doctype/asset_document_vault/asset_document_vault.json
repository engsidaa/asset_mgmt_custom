{
 "doctype": "DocType",
 "name": "Asset Document Vault",
 "module": "Asset Mgmt Custom",
 "is_submittable": 0,
 "track_changes": 1,
 "autoname": "naming_series:",
 "naming_series": "ADOC-.YYYY.-",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "ADOC-.YYYY.-"
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "الأصل",
   "options": "Asset",
   "reqd": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Select",
   "label": "نوع المستند",
   "description": "نوع الوثيقة: فاتورة أو شهادة أو عقد أو غيرها",
   "options": "Invoice\nWarranty Card\nInsurance Policy\nMaintenance Contract\nCertificate\nManual\nPhoto\nOther",
   "reqd": 1
  },
  {
   "fieldname": "document_title",
   "fieldtype": "Data",
   "label": "عنوان المستند",
   "description": "اسم أو عنوان الوثيقة",
   "reqd": 1
  },
  {
   "fieldname": "document_date",
   "fieldtype": "Date",
   "label": "تاريخ المستند"
  },
  {
   "fieldname": "expiry_date",
   "fieldtype": "Date",
   "label": "تاريخ انتهاء الصلاحية",
   "description": "تاريخ انتهاء صلاحية الوثيقة إن وجد"
  },
  {
   "fieldname": "document_file",
   "fieldtype": "Attach",
   "label": "ملف الوثيقة",
   "description": "ارفع نسخة من المستند هنا",
   "reqd": 1
  },
  {
   "fieldname": "issued_by",
   "fieldtype": "Data",
   "label": "جهة الإصدار",
   "description": "المنظمة أو الجهة التي أصدرت الوثيقة"
  },
  {
   "fieldname": "reference_number",
   "fieldtype": "Data",
   "label": "رقم المرجع",
   "description": "رقم الوثيقة أو المرجع الرسمي"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "ملاحظات"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1,
   "create": 1,
   "print": 1
  }
 ]
}