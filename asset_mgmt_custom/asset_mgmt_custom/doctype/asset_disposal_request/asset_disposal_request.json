{
 "doctype": "DocType",
 "name": "Asset Disposal Request",
 "module": "Asset Mgmt Custom",
 "naming_rule": "Expression",
 "autoname": "format:DISP-{asset}-{#####}",
 "is_submittable": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "options": "Asset",
   "label": "الأصل",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1
  },
  {
   "fieldname": "col1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "disposal_date",
   "fieldtype": "Date",
   "label": "تاريخ التخلص المطلوب",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "الحالة",
   "options": "Draft\nPending Approval\nApproved\nRejected",
   "default": "Draft",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "reason_section",
   "fieldtype": "Section Break",
   "label": "سبب التخلص"
  },
  {
   "fieldname": "disposal_reason",
   "fieldtype": "Select",
   "label": "سبب التخلص",
   "description": "المبرر الرئيسي للتخلص من الأصل",
   "options": "End of Life\nBeyond Repair\nTechnology Obsolescence\nSurplus\nLoss / Theft\nOther",
   "reqd": 1
  },
  {
   "fieldname": "col2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "disposal_method",
   "fieldtype": "Select",
   "label": "أسلوب التخلص المقترح",
   "description": "الطريقة المقترحة: بيع، خردة، تبرع...",
   "options": "Scrap\nSale\nDonation\nWrite-off"
  },
  {
   "fieldname": "reason_notes",
   "fieldtype": "Long Text",
   "label": "التفاصيل"
  },
  {
   "fieldname": "finance_section",
   "fieldtype": "Section Break",
   "label": "التفاصيل المالية"
  },
  {
   "fieldname": "book_value",
   "fieldtype": "Currency",
   "label": "القيمة الدفترية الحالية",
   "read_only": 1
  },
  {
   "fieldname": "col3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "estimated_realizable_value",
   "fieldtype": "Currency",
   "label": "القيمة التقديرية عند التخلص"
  },
  {
   "fieldname": "approval_section",
   "fieldtype": "Section Break",
   "label": "سجل الاعتماد"
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "معتمد من",
   "read_only": 1
  },
  {
   "fieldname": "col4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "approval_date",
   "fieldtype": "Date",
   "label": "تاريخ الاعتماد",
   "read_only": 1
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Small Text",
   "label": "سبب الرفض"
  }
 ],
 "permissions": [
  {
   "role": "Accounts Manager",
   "read": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Assets Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
