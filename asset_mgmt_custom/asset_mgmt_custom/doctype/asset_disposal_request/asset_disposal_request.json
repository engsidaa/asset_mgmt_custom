{
  "doctype": "DocType",
  "name": "Asset Disposal Request",
  "module": "Asset Mgmt Custom",
  "naming_rule": "Expression",
  "autoname": "format:DISP-{asset}-{#####}",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "asset", "fieldtype": "Link", "options": "Asset", "label": "Asset", "reqd": 1, "in_list_view": 1, "search_index": 1},
    {"fieldname": "asset_name", "fieldtype": "Data", "label": "Asset Name", "fetch_from": "asset.asset_name", "read_only": 1},
    {"fieldname": "col1", "fieldtype": "Column Break"},
    {"fieldname": "disposal_date", "fieldtype": "Date", "label": "Requested Disposal Date", "reqd": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Approval Status", "options": "Draft\nPending Approval\nApproved\nRejected", "default": "Draft", "in_list_view": 1, "read_only": 1},
    {"fieldname": "reason_section", "fieldtype": "Section Break", "label": "Disposal Reason"},
    {"fieldname": "disposal_reason", "fieldtype": "Select", "label": "Disposal Reason", "options": "End of Life\nBeyond Repair\nTechnology Obsolescence\nSurplus\nLoss / Theft\nOther", "reqd": 1},
    {"fieldname": "col2", "fieldtype": "Column Break"},
    {"fieldname": "disposal_method", "fieldtype": "Select", "label": "Disposal Method", "options": "Scrap\nSale\nDonation\nWrite-off"},
    {"fieldname": "reason_notes", "fieldtype": "Long Text", "label": "Details"},
    {"fieldname": "finance_section", "fieldtype": "Section Break", "label": "Financial Details"},
    {"fieldname": "book_value", "fieldtype": "Currency", "label": "Current Book Value", "read_only": 1},
    {"fieldname": "col3", "fieldtype": "Column Break"},
    {"fieldname": "estimated_realizable_value", "fieldtype": "Currency", "label": "Estimated Realizable Value"},
    {"fieldname": "approval_section", "fieldtype": "Section Break", "label": "Approval Trail"},
    {"fieldname": "approved_by", "fieldtype": "Link", "options": "User", "label": "Approved By", "read_only": 1},
    {"fieldname": "col4", "fieldtype": "Column Break"},
    {"fieldname": "approval_date", "fieldtype": "Date", "label": "Approval Date", "read_only": 1},
    {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Rejection Reason"}
  ],
  "permissions": [
    {"role": "Assets Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Accounts Manager", "read": 1}
  ],
  "links": [],
  "actions": []
}
