{
  "doctype": "DocType",
  "name": "Asset Checkout",
  "module": "Asset Mgmt Custom",
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "options": "CHKOUT-.YYYY.-",
      "default": "CHKOUT-.YYYY.-"
    },
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Asset",
      "options": "Asset",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1,
      "bold": 1
    },
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "fetch_from": "asset.asset_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Checked Out\nReturned\nOverdue",
      "default": "Checked Out",
      "read_only": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Branch",
      "fetch_from": "asset.custom_branch"
    },
    {
      "fieldname": "sec_break_checkout",
      "fieldtype": "Section Break",
      "label": "Checkout Details"
    },
    {
      "fieldname": "checked_out_by",
      "fieldtype": "Link",
      "label": "Checked Out By",
      "options": "Employee",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "checkout_datetime",
      "fieldtype": "Datetime",
      "label": "Checkout Date & Time",
      "reqd": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "expected_return",
      "fieldtype": "Datetime",
      "label": "Expected Return",
      "reqd": 1
    },
    {
      "fieldname": "purpose",
      "fieldtype": "Text",
      "label": "Purpose"
    },
    {
      "fieldname": "sec_break_return",
      "fieldtype": "Section Break",
      "label": "Return Details"
    },
    {
      "fieldname": "actual_return_datetime",
      "fieldtype": "Datetime",
      "label": "Actual Return Date & Time",
      "read_only": 1
    },
    {
      "fieldname": "condition_on_return",
      "fieldtype": "Select",
      "label": "Condition on Return",
      "options": "\nGood\nDamaged\nLost"
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "return_notes",
      "fieldtype": "Text",
      "label": "Return Notes"
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1},
    {"role": "Asset User", "read": 1, "write": 1, "create": 1, "submit": 1}
  ]
}
