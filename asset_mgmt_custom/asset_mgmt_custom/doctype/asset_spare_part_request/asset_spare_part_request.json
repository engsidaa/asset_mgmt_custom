{
  "doctype": "DocType",
  "name": "Asset Spare Part Request",
  "module": "Asset Mgmt Custom",
  "is_submittable": 1,
  "track_changes": 1,
  "naming_rule": "By \"Naming Series\" field",
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "SPR-.YYYY.-"},
    {"fieldname": "asset", "fieldtype": "Link", "options": "Asset", "label": "Asset", "reqd": 1},
    {"fieldname": "asset_name", "fieldtype": "Data", "label": "Asset Name", "fetch_from": "asset.asset_name", "read_only": 1},
    {"fieldname": "requested_by", "fieldtype": "Link", "options": "Employee", "label": "Requested By", "reqd": 1},
    {"fieldname": "department", "fieldtype": "Link", "options": "Department", "label": "Department", "fetch_from": "requested_by.department", "read_only": 1},
    {"fieldname": "request_date", "fieldtype": "Date", "label": "Request Date", "reqd": 1, "default": "Today"},
    {"fieldname": "spare_part", "fieldtype": "Link", "options": "Asset Spare Part", "label": "Spare Part", "reqd": 1},
    {"fieldname": "spare_part_name", "fieldtype": "Data", "label": "Part Name", "fetch_from": "spare_part.item_name", "read_only": 1},
    {"fieldname": "quantity_requested", "fieldtype": "Float", "label": "Quantity Requested", "reqd": 1, "default": "1"},
    {"fieldname": "quantity_issued", "fieldtype": "Float", "label": "Quantity Issued", "read_only": 1, "default": "0"},
    {"fieldname": "purpose", "fieldtype": "Small Text", "label": "Purpose / Reason"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nApproved\nIssued\nRejected\nCancelled", "default": "Pending"},
    {"fieldname": "approved_by", "fieldtype": "Link", "options": "User", "label": "Approved By", "read_only": 1},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 0}
  ]
}
