   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Employee",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
