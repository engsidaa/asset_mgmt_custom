{
 "doctype": "DocType",
 "name": "Asset Insurance Renewal",
 "module": "Asset Mgmt Custom",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "is_submittable": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Naming Series",
   "options": "INSREN-.YYYY.-",
   "default": "INSREN-.YYYY.-"
  },
  {
   "fieldname": "asset",
   "fieldtype": "Link",
   "label": "الأصل",
   "options": "Asset",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "bold": 1
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "اسم الأصل",
   "fetch_from": "asset.asset_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "renewal_status",
   "fieldtype": "Select",
   "label": "حالة التجديد",
   "options": "Draft\nPending\nRenewed\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "sec_break_current",
   "fieldtype": "Section Break",
   "label": "Current Policy"
  },
  {
   "fieldname": "current_insurer",
   "fieldtype": "Data",
   "label": "Current Insurer",
   "fetch_from": "asset.insurer",
   "read_only": 1
  },
  {
   "fieldname": "current_policy_number",
   "fieldtype": "Data",
   "label": "Current Policy Number",
   "fetch_from": "asset.policy_number",
   "read_only": 1
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "current_expiry_date",
   "fieldtype": "Date",
   "label": "Current Expiry Date",
   "fetch_from": "asset.insurance_end_date",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sec_break_new",
   "fieldtype": "Section Break",
   "label": "New Policy"
  },
  {
   "fieldname": "new_insurer",
   "fieldtype": "Data",
   "label": "شركة التأمين الجديدة",
   "description": "اسم شركة التأمين التي سيُجدَّد معها العقد"
  },
  {
   "fieldname": "new_policy_number",
   "fieldtype": "Data",
   "label": "رقم وثيقة التأمين الجديدة"
  },
  {
   "fieldname": "new_premium",
   "fieldtype": "Currency",
   "label": "New Premium"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "new_start_date",
   "fieldtype": "Date",
   "label": "تاريخ بدء التأمين الجديد"
  },
  {
   "fieldname": "new_end_date",
   "fieldtype": "Date",
   "label": "تاريخ انتهاء التأمين الجديد",
   "in_list_view": 1
  },
  {
   "fieldname": "sec_break_docs",
   "fieldtype": "Section Break",
   "label": "Notes & Documents"
  },
  {
   "fieldname": "comparison_notes",
   "fieldtype": "Text Editor",
   "label": "Comparison Notes"
  },
  {
   "fieldname": "col_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "policy_document",
   "fieldtype": "Attach",
   "label": "Policy Document"
  },
  {
   "fieldname": "cost_center",
   "fieldtype": "Link",
   "label": "مركز التكلفة",
   "options": "Cost Center",
   "description": "مركز التكلفة لمصاريف التأمين."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Assets Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Finance Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "Asset Technician",
   "read": 1,
   "print": 1
  },
  {
   "role": "Asset User",
   "read": 1
  }
 ]
}