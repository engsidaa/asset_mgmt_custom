{
  "doctype": "DocType",
  "name": "Asset Requisition",
  "module": "Asset Mgmt Custom",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "AR-.YYYY.-",
      "reqd": 1
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Branch"
    },
    {
      "fieldname": "request_date",
      "fieldtype": "Date",
      "label": "Request Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "required_by",
      "fieldtype": "Date",
      "label": "Required By"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nPending Approval\nApproved\nRejected\nFulfilled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "bold": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "asset_category",
      "fieldtype": "Link",
      "label": "Asset Category",
      "options": "Asset Category",
      "reqd": 1
    },
    {
      "fieldname": "item_code",
      "fieldtype": "Link",
      "label": "Item",
      "options": "Item"
    },
    {
      "fieldname": "quantity",
      "fieldtype": "Int",
      "label": "Quantity",
      "default": "1"
    },
    {
      "fieldname": "section_details",
      "fieldtype": "Section Break",
      "label": "Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    },
    {
      "fieldname": "justification",
      "fieldtype": "Text",
      "label": "Justification (المبرر)"
    },
    {
      "fieldname": "section_spare",
      "fieldtype": "Section Break",
      "label": "Spare Asset"
    },
    {
      "fieldname": "spare_available",
      "fieldtype": "Check",
      "label": "Spare Asset Available",
      "read_only": 1
    },
    {
      "fieldname": "spare_asset",
      "fieldtype": "Link",
      "label": "Spare Asset",
      "options": "Asset",
      "read_only": 1
    },
    {
      "fieldname": "section_rejection",
      "fieldtype": "Section Break",
      "label": "Rejection"
    },
    {
      "fieldname": "rejection_reason",
      "fieldtype": "Small Text",
      "label": "Rejection Reason",
      "read_only": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Asset Requisition",
      "read_only": 1,
      "print_hide": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "Assets Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "Employee",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
