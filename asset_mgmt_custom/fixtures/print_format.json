[
  {
    "doctype": "Print Format",
    "name": "Asset Handover Certificate",
    "doc_type": "Asset Handover",
    "module": "Asset Mgmt Custom",
    "standard": "No",
    "print_format_type": "Jinja",
    "html": "{% set items = doc.items or [] %}\n<style>\n  body { font-family: Arial, sans-serif; font-size: 12px; color: #1a1a1a; }\n  .cert-header { text-align: center; border-bottom: 3px solid #1e3a5f; padding-bottom: 12px; margin-bottom: 20px; }\n  .cert-header h1 { font-size: 20px; color: #1e3a5f; margin: 0 0 4px 0; }\n  .cert-header h2 { font-size: 14px; color: #64748b; margin: 0; font-weight: normal; }\n  .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }\n  .meta-box { border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 14px; }\n  .meta-box label { font-size: 10px; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; display: block; margin-bottom: 2px; }\n  .meta-box span { font-size: 14px; font-weight: 600; color: #1e3a5f; }\n  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }\n  th { background: #1e3a5f; color: #fff; padding: 8px 10px; text-align: left; font-size: 11px; }\n  td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; font-size: 11px; }\n  tr:nth-child(even) td { background: #f8fafc; }\n  .sig-row { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 40px; }\n  .sig-box { border-top: 1px solid #334155; padding-top: 8px; text-align: center; }\n  .sig-box p { margin: 2px 0; font-size: 11px; color: #475569; }\n  .condition-good { color: #16a34a; }\n  .condition-damaged { color: #dc2626; }\n  .condition-missing { color: #ea580c; }\n  .condition-fair { color: #d97706; }\n  .footer { font-size: 9px; color: #94a3b8; text-align: center; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 8px; }\n</style>\n\n<div class=\"cert-header\">\n  <h1>Asset Handover Certificate — وثيقة تسليم واستلام الأصول</h1>\n  <h2>{{ doc.name }} | {{ doc.branch }} | {{ doc.handover_date }}</h2>\n</div>\n\n<div class=\"meta-grid\">\n  <div class=\"meta-box\">\n    <label>Outgoing Manager — المسلّم</label>\n    <span>{{ doc.outgoing_manager }}</span>\n    {% if doc.outgoing_manager_title %}<p style=\"color:#64748b;font-size:11px;margin:2px 0 0;\">{{ doc.outgoing_manager_title }}</p>{% endif %}\n  </div>\n  <div class=\"meta-box\">\n    <label>Incoming Manager — المستلِم</label>\n    <span>{{ doc.incoming_manager }}</span>\n    {% if doc.incoming_manager_title %}<p style=\"color:#64748b;font-size:11px;margin:2px 0 0;\">{{ doc.incoming_manager_title }}</p>{% endif %}\n  </div>\n  <div class=\"meta-box\">\n    <label>Branch — الفرع</label>\n    <span>{{ doc.branch }}</span>\n  </div>\n  <div class=\"meta-box\">\n    <label>Handover Date — تاريخ التسليم</label>\n    <span>{{ doc.handover_date }}</span>\n  </div>\n</div>\n\n<table>\n  <thead>\n    <tr>\n      <th>#</th>\n      <th>Asset</th>\n      <th>Name</th>\n      <th>Category</th>\n      <th>Serial No</th>\n      <th>Condition</th>\n      <th>Remarks</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for item in items %}\n    <tr>\n      <td>{{ loop.index }}</td>\n      <td>{{ item.asset }}</td>\n      <td>{{ item.asset_name or '' }}</td>\n      <td>{{ item.asset_category or '' }}</td>\n      <td>{{ item.serial_no or '' }}</td>\n      <td class=\"condition-{{ (item.condition or 'good') | lower }}\">{{ item.condition or 'Good' }}</td>\n      <td>{{ item.remarks or '' }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n</table>\n\n<div style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px 14px;display:inline-grid;grid-template-columns:1fr 1fr 1fr;gap:16px;width:100%;box-sizing:border-box;\">\n  <div style=\"text-align:center;\"><div style=\"font-size:22px;font-weight:700;color:#1e3a5f;\">{{ doc.total_assets or 0 }}</div><div style=\"font-size:10px;color:#64748b;\">Total Assets</div></div>\n  <div style=\"text-align:center;\"><div style=\"font-size:22px;font-weight:700;color:#16a34a;\">{{ doc.good_count or 0 }}</div><div style=\"font-size:10px;color:#64748b;\">Good Condition</div></div>\n  <div style=\"text-align:center;\"><div style=\"font-size:22px;font-weight:700;color:#dc2626;\">{{ doc.damaged_count or 0 }}</div><div style=\"font-size:10px;color:#64748b;\">Damaged / Issues</div></div>\n</div>\n\n{% if doc.notes %}\n<div style=\"margin-top:16px;padding:10px 14px;border-left:4px solid #1e3a5f;background:#f0f4ff;border-radius:0 6px 6px 0;\">\n  <strong>Notes:</strong> {{ doc.notes }}\n</div>\n{% endif %}\n\n<div class=\"sig-row\">\n  <div class=\"sig-box\">\n    <p><strong>{{ doc.outgoing_manager }}</strong></p>\n    <p>{{ doc.outgoing_manager_title or 'Outgoing Manager' }}</p>\n    <p>Signature: ____________________</p>\n    <p>Date: ____________________</p>\n  </div>\n  <div class=\"sig-box\">\n    <p><strong>{{ doc.incoming_manager }}</strong></p>\n    <p>{{ doc.incoming_manager_title or 'Incoming Manager' }}</p>\n    <p>Signature: ____________________</p>\n    <p>Date: ____________________</p>\n  </div>\n</div>\n\n<div class=\"footer\">\n  Generated by Asset Management System | {{ doc.name }} | {{ frappe.utils.now()[:10] }}\n</div>"
  },
  {
    "doctype": "Print Format",
    "name": "Asset Tag",
    "doc_type": "Asset",
    "module": "Asset Mgmt Custom",
    "standard": "No",
    "print_format_type": "Jinja",
    "html": "<style>\n  @page { size: 80mm 50mm; margin: 3mm; }\n  body { font-family: Arial, sans-serif; margin: 0; padding: 0; }\n  .tag { width: 74mm; height: 44mm; border: 1.5px solid #1e3a5f; border-radius: 3mm; display: flex; align-items: stretch; overflow: hidden; box-sizing: border-box; }\n  .tag-left { flex: 1; padding: 3mm; display: flex; flex-direction: column; justify-content: space-between; }\n  .tag-right { width: 22mm; background: #f8fafc; border-left: 1px solid #e2e8f0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2mm; }\n  .org-name { font-size: 6pt; font-weight: bold; color: #1e3a5f; text-transform: uppercase; letter-spacing: 0.5pt; }\n  .asset-id { font-size: 9pt; font-weight: 900; color: #1e3a5f; margin: 0.5mm 0; }\n  .asset-name { font-size: 7pt; color: #334155; font-weight: 600; }\n  .meta-row { font-size: 6pt; color: #64748b; margin-top: 0.5mm; }\n  .meta-label { font-weight: bold; }\n  #qr-canvas { width: 18mm !important; height: 18mm !important; }\n  .qr-label { font-size: 5pt; color: #94a3b8; margin-top: 1mm; text-align: center; }\n</style>\n\n<div class=\"tag\">\n  <div class=\"tag-left\">\n    <div class=\"org-name\">{{ frappe.defaults.get_user_default('company') or 'Asset Management' }}</div>\n    <div>\n      <div class=\"asset-id\">{{ doc.name }}</div>\n      <div class=\"asset-name\">{{ doc.asset_name }}</div>\n    </div>\n    <div>\n      <div class=\"meta-row\"><span class=\"meta-label\">Category:</span> {{ doc.asset_category or '—' }}</div>\n      <div class=\"meta-row\"><span class=\"meta-label\">Location:</span> {{ doc.location or doc.custom_branch or '—' }}</div>\n      {% if doc.serial_no %}<div class=\"meta-row\"><span class=\"meta-label\">S/N:</span> {{ doc.serial_no }}</div>{% endif %}\n    </div>\n  </div>\n  <div class=\"tag-right\">\n    <canvas id=\"qr-canvas\"></canvas>\n    <div class=\"qr-label\">Scan for details</div>\n  </div>\n</div>\n\n<script>\n(function(){\n  // Tiny QR code generator embedded inline — no external dependency\n  // Based on qrcode-generator by Kazuhiko Arase (MIT License)\n  var qrAssetUrl = window.location.origin + '/app/asset/{{ doc.name | urlencode }}';\n\n  // Use QRCode library if already loaded by Frappe, else draw text fallback\n  function drawFallback(canvas, text) {\n    var ctx = canvas.getContext('2d');\n    canvas.width = 68; canvas.height = 68;\n    ctx.fillStyle = '#fff';\n    ctx.fillRect(0,0,68,68);\n    ctx.fillStyle = '#1e3a5f';\n    ctx.font = '5px Arial';\n    ctx.textAlign = 'center';\n    ctx.fillText('{{ doc.name }}', 34, 34);\n  }\n\n  function initQR() {\n    var canvas = document.getElementById('qr-canvas');\n    if (!canvas) return;\n    if (typeof QRCode !== 'undefined') {\n      new QRCode(canvas, { text: qrAssetUrl, width: 68, height: 68, colorDark: '#1e3a5f', colorLight: '#ffffff', correctLevel: QRCode.CorrectLevel.M });\n    } else {\n      drawFallback(canvas, qrAssetUrl);\n    }\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initQR);\n  } else {\n    initQR();\n  }\n})();\n</script>"
  }
]
