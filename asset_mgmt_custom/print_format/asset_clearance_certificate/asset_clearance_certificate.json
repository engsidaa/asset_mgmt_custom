{
  "doctype": "Print Format",
  "name": "Asset Clearance Certificate",
  "doc_type": "Full and Final Statement",
  "module": "Asset Mgmt Custom",
  "print_format_type": "Jinja",
  "standard": "No",
  "disabled": 0,
  "html": "{%- set employee_doc = frappe.get_doc(\"Employee\", doc.employee) -%}\n<div style=\"font-family: Arial, sans-serif; direction: rtl; padding: 30px;\">\n  <div style=\"text-align: center; border-bottom: 3px solid #1A6B42; padding-bottom: 20px; margin-bottom: 24px;\">\n    <h2 style=\"color: #1A6B42; margin: 0;\">{{ doc.company }}</h2>\n    <h3 style=\"margin: 10px 0 0 0;\">شهادة تصفية أصول موظف</h3>\n    <h4 style=\"font-weight: normal; margin: 4px 0 0 0; color: #555;\">Employee Asset Clearance Certificate</h4>\n  </div>\n\n  <div style=\"background: #f0faf4; border-right: 4px solid #1A6B42; padding: 16px; margin-bottom: 20px;\">\n    <table style=\"width:100%\">\n      <tr>\n        <td><b>الموظف / Employee:</b> {{ employee_doc.employee_name }} ({{ doc.employee }})</td>\n        <td><b>القسم / Department:</b> {{ employee_doc.department or '—' }}</td>\n      </tr>\n      <tr>\n        <td><b>تاريخ الإجراء / Date:</b> {{ frappe.utils.today() }}</td>\n        <td><b>تاريخ نهاية الخدمة / Relieving Date:</b> {{ frappe.format(doc.relieving_date, 'Date') }}</td>\n      </tr>\n    </table>\n  </div>\n\n  <p style=\"font-size:14px;\">\n    يُشهد بموجب هذه الشهادة أن الموظف المذكور أعلاه قد أعاد جميع الأصول الثابتة المُسندة إليه\n    وليس عليه أي التزامات متعلقة بأصول الشركة.\n  </p>\n  <p style=\"font-size:13px; color:#555; margin-bottom: 20px;\">\n    This certificate confirms that the above-named employee has returned all fixed assets\n    assigned to them and has no outstanding asset obligations.\n  </p>\n\n  {%- if doc.assets_allocated %}\n  <table style=\"width:100%; border-collapse:collapse; font-size:13px; margin-bottom:20px;\">\n    <thead>\n      <tr style=\"background:#1A6B42; color:#fff;\">\n        <th style=\"padding:8px; border:1px solid #ccc;\">الأصل</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">اسم الأصل</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">تاريخ التسليم</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">الإجراء</th>\n        <th style=\"padding:8px; border:1px solid #ccc;\">الحالة</th>\n      </tr>\n    </thead>\n    <tbody>\n      {%- for asset in doc.assets_allocated %}\n      <tr>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ asset.reference }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ asset.asset_name }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ frappe.format(asset.date, 'Date') if asset.date else '—' }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd;\">{{ asset.action }}</td>\n        <td style=\"padding:6px 8px; border:1px solid #ddd; color: {{ '#1A6B42' if asset.status != 'Owned' else '#9B2C18' }}\">{{ asset.status }}</td>\n      </tr>\n      {%- endfor %}\n    </tbody>\n  </table>\n  {%- else %}\n  <p style=\"color:#1A6B42;\"><b>✓ لا توجد أصول مُسندة للموظف / No assets allocated to this employee.</b></p>\n  {%- endif %}\n\n  <div style=\"display:flex; gap:40px; margin-top:50px;\">\n    <div style=\"flex:1; border-top:1px solid #333; padding-top:8px; text-align:center;\">\n      <div>مدير الموارد البشرية</div>\n      <div style=\"color:#888; font-size:12px; margin-top:4px;\">HR Manager</div>\n      <div style=\"margin-top:40px; font-size:12px; color:#666;\">التوقيع / Signature</div>\n    </div>\n    <div style=\"flex:1; border-top:1px solid #333; padding-top:8px; text-align:center;\">\n      <div>مدير الأصول</div>\n      <div style=\"color:#888; font-size:12px; margin-top:4px;\">Assets Manager</div>\n      <div style=\"margin-top:40px; font-size:12px; color:#666;\">التوقيع / Signature</div>\n    </div>\n    <div style=\"flex:1; border-top:1px solid #333; padding-top:8px; text-align: center;\">\n      <div>الموظف</div>\n      <div style=\"color:#888; font-size:12px; margin-top:4px;\">Employee</div>\n      <div style=\"margin-top:40px; font-size:12px; color:#666;\">التوقيع / Signature</div>\n    </div>\n  </div>\n\n  <div style=\"text-align:center; margin-top:30px; font-size:11px; color:#aaa; border-top:1px solid #eee; padding-top:8px;\">\n    {{ doc.company }} — ERP System — {{ frappe.utils.now() }}\n  </div>\n</div>"
}
